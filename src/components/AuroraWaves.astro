---
/**
 * Atmospheric background.
 *
 * Three heavily blurred orbs in fixed positions behind all content (z-0).
 * Colours come from --aurora-1/2/3 so each theme sets its own palette:
 * electric cyan / deep violet / teal on dark, warm orange / soft amber /
 * desaturated cyan on light.
 *
 * Deliberately static. The previous version ran three infinite GSAP tweens
 * plus a mousemove parallax on a 100px-blur layer, which is continuous
 * compositor work for decoration. Locking the positions removes that entirely
 * and keeps contrast ratios stable, since text never sits over a moving colour.
 */
---

<div class="aurora" aria-hidden="true">
  <div class="blobs">
    <div class="blob blob--1"></div>
    <div class="blob blob--2"></div>
    <div class="blob blob--3"></div>
  </div>
</div>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: var(--aurora-wrap-opacity);
    contain: strict;
    overflow: hidden;
    /* Soften the edges so the orbs never end in a hard cut. */
    -webkit-mask-image: radial-gradient(125% 85% at 50% 45%, #000 32%, transparent 80%);
    mask-image: radial-gradient(125% 85% at 50% 45%, #000 32%, transparent 80%);
  }

  .blobs {
    position: absolute;
    inset: -25%;
    filter: blur(110px);
    -webkit-filter: blur(110px);
  }

  .blob {
    position: absolute;
    border-radius: 50%;
  }

  /* Primary highlight, anchored top-left in both themes. */
  .blob--1 {
    top: 6%;
    left: 4%;
    width: 46%;
    height: 46%;
    background: rgb(var(--aurora-1));
    opacity: var(--aurora-a1);
  }

  .blob--2 {
    top: 2%;
    right: 6%;
    width: 40%;
    height: 42%;
    background: rgb(var(--aurora-2));
    opacity: var(--aurora-a2);
  }

  .blob--3 {
    bottom: 4%;
    right: 14%;
    width: 48%;
    height: 46%;
    background: rgb(var(--aurora-3));
    opacity: var(--aurora-a3);
  }

  @media (max-width: 767px) {
    /* Cheaper blur on mobile GPUs; the orbs are decorative at this size. */
    .blobs {
      filter: blur(70px);
      -webkit-filter: blur(70px);
    }
  }

  /* Nothing animates any more, so this layer is safe to keep under
     reduced-motion — it used to be hidden only because it moved. */
</style>

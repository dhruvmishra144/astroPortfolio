---
const quadrants = [
  {
    title: 'FEELS',
    style: 'bg-pink-100 border-2 border-pink-300',
    items: [
      'Anxious before hitting Run',
      'Overwhelmed by technical jargon',
      'Responsible for data integrity',
      'Frustrated when integrations break',
    ],
  },
  {
    title: 'SAYS',
    style: 'bg-orange-100 border-2 border-orange-300',
    items: [
      '"I need to sync data between tools without breaking anything"',
      '"Our tools don\'t talk to each other"',
      '"I don\'t have time to learn code"',
      '"What if I delete the wrong records?"',
    ],
  },
  {
    title: 'DOES',
    style: 'bg-yellow-100 border-2 border-yellow-400',
    items: [
      'Manually copy-paste data between systems (4-8 hours/week)',
      'Tests integrations in separate sandbox',
      'Exports files with dummy data',
      'Checks logs after runs',
      "But can't undo mistakes",
      'Calls developer when something breaks',
    ],
  },
  {
    title: 'THINKS',
    style: 'bg-pink-100 border-2 border-pink-300',
    items: [
      '"This should just work, but what if I mess up?"',
      'My boss needs this working by tomorrow',
      "I can't undo data changes – they'll blame me",
      'Will my team blame me if integration fails?',
    ],
  },
];

const painPoints = [
  'Fear of irreversible data mistakes',
  'No clear recovery path if execution fails',
  'Hidden/unclear error states',
  "Can't see blast radius of operations",
  'Lack of hands-on technical training',
];

const gains = [
  'Visibility into what will happen before execution',
  'One-click undo capability',
  'Clear error logs and documentation',
  'Self-service recovery without developer escalation',
  'Time savings from reduced manual reconciliation',
];
---

<div class="w-full max-w-6xl mx-auto p-4 md:p-8 bg-white">
  {/* Header */}
  <div class="text-center mb-6 md:mb-8">
    <h1 class="text-xl sm:text-2xl md:text-3xl text-gray-600 mb-2 font-medium">
      GoFlow User Empathy Map: SMB Ops/RevOps Operator
    </h1>
    <p class="text-sm md:text-base text-gray-500">Confidence from reversibility, not simplicity</p>
  </div>

  {/* Tags */}
  <div class="flex flex-wrap justify-center gap-2 md:gap-4 mb-8 text-black">
    <div class="px-3 md:px-4 py-1.5 md:py-2 bg-blue-100 border border-blue-300 rounded text-xs md:text-sm">
      <span class="font-semibold">Persona:</span> SMB Ops/RevOps Operator
    </div>
    <div class="px-3 md:px-4 py-1.5 md:py-2 bg-blue-100 border border-blue-300 rounded text-xs md:text-sm">
      <span class="font-semibold">Company Size:</span> 20-250 employees
    </div>
    <div class="px-3 md:px-4 py-1.5 md:py-2 bg-yellow-100 border border-yellow-400 rounded text-xs md:text-sm">
      <span class="font-semibold">Tech Literacy:</span> Beginner → Intermediate
    </div>
  </div>

  {/* Empathy Map Grid */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-6">
    {
      quadrants.map((quadrant) => (
        <div class={`${quadrant.style} rounded-lg p-4 md:p-6`}>
          <h2 class="text-lg md:text-xl font-semibold text-gray-700 mb-3 md:mb-4">{quadrant.title}</h2>
          <ul class="space-y-1.5 md:space-y-2 text-xs md:text-sm text-gray-700">
            {quadrant.items.map((item) => (
              <li class="flex items-start">
                <span class="mr-2">●</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  {/* User Quote - Center */}
  <div class="flex justify-center mb-6">
    <div class="relative">
      <div class="bg-yellow-200 border-2 border-yellow-400 rounded-lg p-3 md:p-4 max-w-lg md:max-w-sm mx-auto">
        <p class="text-xs md:text-sm text-gray-700 text-center font-medium">
          User Quote:
          <br />
          "I get it. I don't know how to undo this if it goes wrong."
        </p>
      </div>
      <div class="flex justify-center mt-2">
        <svg class="w-6 h-6 md:w-8 md:h-8 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M10 3a1 1 0 011 1v10.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 14.586V4a1 1 0 011-1z"
            clip-rule="evenodd"></path>
        </svg>
      </div>
    </div>
  </div>

  {/* Bottom Section - Pain Points and Gains */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-6">
    <div class="bg-pink-100 border-2 border-pink-300 rounded-lg p-4 md:p-6">
      <h2 class="text-lg md:text-xl font-semibold text-gray-700 mb-3 md:mb-4">PAIN POINTS</h2>
      <ul class="space-y-1.5 md:space-y-2 text-xs md:text-sm text-gray-700">
        {
          painPoints.map((item) => (
            <li class="flex items-start">
              <span class="mr-2">●</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bg-green-200 border-2 border-green-400 rounded-lg p-4 md:p-6">
      <h2 class="text-lg md:text-xl font-semibold text-gray-700 mb-3 md:mb-4">GAINS</h2>
      <ul class="space-y-1.5 md:space-y-2 text-xs md:text-sm text-gray-700">
        {
          gains.map((item) => (
            <li class="flex items-start">
              <span class="mr-2">●</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {/* Stakes */}
  <div class="bg-white border-2 border-pink-400 rounded-lg p-3 md:p-4 mb-4">
    <p class="text-xs md:text-sm text-gray-700 text-center">
      <span class="font-semibold">Stakes:</span> Revenue-critical systems: CRM, Finance sync, Customer
      data accuracy, Process automation
    </p>
  </div>

  {/* Confidence Scale */}
  <div class="flex items-center justify-between text-xs md:text-sm px-4">
    <span class="text-red-500 font-medium">← Anxious</span>
    <span class="text-green-600 font-medium">Confident →</span>
  </div>
</div>

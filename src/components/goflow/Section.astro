---
/**
 * Panel section used by the GoFlow case study.
 *
 * `tone` controls panel emphasis only. Text colours come from tokens in both
 * tones — the page's own content classes are light-authored and flipped for
 * dark by the scoped override block in GoFlow.astro, but this shell is
 * portfolio chrome and must follow the theme directly.
 */
interface Props {
  title: string;
  eyebrow?: string;
  tone?: 'light' | 'dark';
}

const { title, eyebrow, tone = 'dark' } = Astro.props;
const isStrong = tone === 'dark';
---

<section
  class:list={[
    'project-section container mx-auto flex flex-col gap-8 rounded-[2rem] px-6 py-8 text-foreground sm:px-8 lg:px-10',
    isStrong ? 'surface-strong' : 'surface',
  ]}
>
  <div class="space-y-3">
    {
      eyebrow && (
        <p
          class:list={[
            'text-xs font-semibold uppercase tracking-[0.36em]',
            isStrong ? 'text-accent-text' : 'text-subtle',
          ]}
        >
          {eyebrow}
        </p>
      )
    }
    <h2 class="hero-title text-balance text-3xl text-foreground sm:text-4xl">
      {title}
    </h2>
  </div>

  <div class="space-y-7 text-sm leading-7 text-muted sm:text-base">
    <slot />
  </div>
</section>

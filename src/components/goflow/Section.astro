---
interface Props {
  title: string;
  eyebrow?: string;
  tone?: 'light' | 'dark';
}

const { title, eyebrow, tone = 'dark' } = Astro.props;
const isDark = tone === 'dark';
---

<section
  class:list={[
    'project-section container mx-auto flex flex-col gap-8',
    isDark
      ? 'rounded-[2rem] surface-strong px-6 py-8 text-white sm:px-8 lg:px-10'
      : 'rounded-[2rem] surface px-6 py-8 text-slate-900 sm:px-8 lg:px-10',
  ]}
>
  <div class="space-y-3">
    {eyebrow && (
      <p
        class:list={[
          'text-xs font-semibold uppercase tracking-[0.36em]',
          isDark ? 'text-cyan-300' : 'text-slate-500',
        ]}
      >
        {eyebrow}
      </p>
    )}
    <h2 class:list={['hero-title text-balance text-3xl sm:text-4xl', isDark ? 'text-white' : 'text-slate-950']}>
      {title}
    </h2>
  </div>

  <div class:list={['space-y-7 text-sm leading-7 sm:text-base', isDark ? 'text-slate-300' : 'text-slate-700']}>
    <slot />
  </div>
</section>

---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="my-8 flex aspect-video w-full items-center justify-center rounded-[1.75rem] border border-white/10 bg-white/[0.03] px-6 text-center shadow-[0_28px_90px_rgba(2,8,23,0.18)]">
  <p class="text-sm text-slate-300">
    <span class="block text-xs uppercase tracking-[0.36em] text-slate-400">Figure placeholder</span>
    <span class="mt-3 block">[Image: {title}]</span>
  </p>
</div>

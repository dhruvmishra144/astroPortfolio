---
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/*
  Both icons are rendered and swapped with CSS on [data-theme], because the
  static HTML is built before we know the visitor's stored preference — the
  no-flash script in Base.astro sets data-theme on <html> before first paint,
  so the correct icon is showing by the time anything is visible.
*/}
<button
  type="button"
  data-theme-toggle
  class:list={['theme-toggle', className]}
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Switch theme"
>
  <Icon name="moon" class="theme-toggle__moon" />
  <Icon name="sun" class="theme-toggle__sun" />
  <span class="sr-only-text">Switch theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    background: var(--surface-strong);
    color: var(--muted);
    font-size: 0.95rem;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--accent-text);
    border-color: var(--accent);
  }

  .sr-only-text {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /*
    Show the icon for the action, not the current state.

    These need :global() because the icons are <svg> elements rendered by
    Icon.astro — a child component — so this component's scoping attribute is
    never applied to them.
  */
  .theme-toggle :global(.theme-toggle__sun) {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle :global(.theme-toggle__moon) {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle :global(.theme-toggle__sun) {
    display: inline;
  }
</style>

<script>
  const STORAGE_KEY = 'dm-theme';

  function syncLabel(button: HTMLElement, theme: string) {
    const next = theme === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
    button.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
  }

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');

  buttons.forEach((button) => {
    syncLabel(button, root.dataset.theme ?? 'light');

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;

      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        /* private mode — the toggle still works for this page view */
      }

      buttons.forEach((b) => syncLabel(b, next));
      // Consumers that paint their own colours (e.g. the ECharts canvas on the
      // GoFlow page) cannot read CSS transitions, so tell them explicitly.
      window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
    });
  });
</script>

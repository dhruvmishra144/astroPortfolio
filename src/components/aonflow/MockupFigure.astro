---
interface Props {
  title: string;
  description: string;
  src: string;
}

const { title, description, src } = Astro.props;
---

<figure class="surface overflow-hidden rounded-[2rem]">
  <img
    src={src}
    alt={`${title} mockup`}
    width="1600"
    height="1000"
    class="aspect-[16/10] w-full object-cover object-left-top"
  />
  <figcaption class="grid gap-3 border-t border-border p-5 sm:p-6 lg:grid-cols-[0.34fr_0.66fr]">
    <h3 class="text-xl font-semibold text-foreground">{title}</h3>
    <p class="text-sm leading-7 text-muted">{description}</p>
  </figcaption>
</figure>

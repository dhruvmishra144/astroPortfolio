---
import ContactLinks from './ContactLinks.astro';
---

<header class="sticky top-0 z-40 pt-4">
  <div class="page-shell">
    <div class="surface-strong flex items-center justify-between gap-4 rounded-[1.5rem] px-4 py-3 sm:px-5 sm:py-4">
      <a href="/" class="flex items-center gap-3" aria-label="Dhruv Mishra home" data-transition>
        <img width="56" height="56" src="/logo.svg" alt="Dhruv Mishra" class="h-12 w-12 shrink-0" />
        <div class="hidden sm:block">
          <p class="text-sm font-semibold text-white">Dhruv Mishra</p>
          <p class="text-[11px] uppercase tracking-[0.32em] text-slate-400">UX/UI Designer</p>
        </div>
      </a>
      <ContactLinks />
    </div>
  </div>
</header>

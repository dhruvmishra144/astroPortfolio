---
import Icon from './Icon.astro';
import { socialLinks } from '../data/socialLinks';
---

<div class="flex flex-row items-center justify-center gap-2 sm:gap-3 text-sm">
  {
    socialLinks.map(({ href, name, icon }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} profile`}
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-surface text-muted hover:border-accent hover:bg-accent/10 hover:text-foreground hover:-translate-y-0.5"
      >
        <Icon name={`${icon}-line`} />
      </a>
    ))
  }
</div>

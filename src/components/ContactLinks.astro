---
import Icon from './Icon.astro';
import { socialLinks } from '../data/socialLinks';
---

<div class="flex flex-row items-center justify-center gap-2 sm:gap-3 text-sm">
  {
    socialLinks.map(({ href, name, icon }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} profile`}
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 hover:border-cyan-300/40 hover:bg-cyan-400/10 hover:text-white hover:-translate-y-0.5"
      >
        <Icon name={`${icon}-line`} />
      </a>
    ))
  }
</div>

---
interface Row {
  label: string;
  before: string;
  after: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<div class="grid gap-3">
  {
    rows.map((row) => (
      <div class="flex flex-col gap-3 rounded-2xl border border-border bg-surface p-4">
        <p class="text-sm font-medium text-foreground">{row.label}</p>
        <div class="flex flex-col gap-1.5 text-sm">
          <span class="text-subtle">{row.before}</span>
          <span class="text-accent-text" aria-hidden="true">↓</span>
          <span class="font-semibold text-foreground">{row.after}</span>
        </div>
      </div>
    ))
  }
</div>

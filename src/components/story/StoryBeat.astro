---
interface Props {
  eyebrow?: string;
  headline: string;
  id?: string;
}

const { eyebrow, headline, id } = Astro.props;
---

<section id={id} class="border-t border-white/10 py-14 scroll-mt-24">
  {eyebrow && <p class="section-label mb-4">{eyebrow}</p>}
  <h2 class="hero-title max-w-3xl text-balance text-3xl text-white sm:text-4xl">{headline}</h2>
  <div class="mt-6 max-w-2xl space-y-5 text-base leading-8 text-slate-300 sm:text-lg">
    <slot />
  </div>
</section>

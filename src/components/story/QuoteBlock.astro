---
interface Props {
  quote: string;
  name: string;
  role?: string;
}

const { quote, name, role } = Astro.props;
---

<figure class="border-t border-border py-14">
  <blockquote class="hero-title max-w-3xl text-balance text-2xl leading-snug text-foreground sm:text-3xl">
    “{quote}”
  </blockquote>
  <figcaption class="mt-6 text-sm text-subtle">
    <span class="font-semibold text-foreground">{name}</span>
    {role && <span> — {role}</span>}
  </figcaption>
</figure>

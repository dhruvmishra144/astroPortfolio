---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="flex flex-wrap gap-10 sm:gap-14">
  {
    stats.map((stat) => (
      <div>
        <p class="hero-title text-4xl text-accent-text sm:text-5xl">{stat.value}</p>
        <p class="mt-2 text-xs uppercase tracking-[0.24em] text-subtle">{stat.label}</p>
      </div>
    ))
  }
</div>

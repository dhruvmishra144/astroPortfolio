---
interface Props {
  title: string;
  description: string;
  /** Site-relative path to the share image. */
  image?: string;
  /** Describes the share card itself, not the page. */
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  // The purpose-built 1200x630 card, generated by scripts/build-og.mjs. Re-run
  // that script if the hero claim changes — the card repeats it verbatim.
  image = '/og.png',
  imageAlt = 'Dhruv Mishra, Design Engineer — "I design complex software, then I build it."',
  type = 'website',
  noindex = false,
} = Astro.props;

// `site` is set in astro.config.mjs; without it these URLs cannot be absolute.
// Canonical always resolves to the apex, so www.dhruvmishra.in keeps serving
// normally while search engines are told which host is primary.
//
// Astro hands us "/resume/" at build time, but every link in the site points at
// "/resume" (trailingSlash: 'ignore'). Normalise so the canonical matches the
// URL people actually link to.
const path = Astro.url.pathname;
const normalizedPath = path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
const canonical = new URL(normalizedPath, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// Only claim 1200x630 for the purpose-built card. Any other image passed in is
// of unknown shape, and declaring dimensions that don't match the file is worse
// than declaring none — the scraper crops to the wrong aspect.
const hasCardDimensions = image === '/og.png';
---

<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Dhruv Mishra" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{
  hasCardDimensions && (
    <Fragment>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </Fragment>
  )
}

<meta name="twitter:card" content={hasCardDimensions ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

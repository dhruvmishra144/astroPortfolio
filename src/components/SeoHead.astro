---
interface Props {
  title: string;
  description: string;
  /** Site-relative path to the share image. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  // TODO: replace with a purpose-built 1200x630 light-theme share card at
  // /og.png. Until that asset exists, point at a real image — a 404'd
  // og:image renders worse than an off-format one.
  image = '/avatar.jpeg',
  type = 'website',
  noindex = false,
} = Astro.props;

// `site` is set in astro.config.mjs; without it these URLs cannot be absolute.
// Canonical always resolves to the apex, so www.dhruvmishra.in keeps serving
// normally while search engines are told which host is primary.
//
// Astro hands us "/resume/" at build time, but every link in the site points at
// "/resume" (trailingSlash: 'ignore'). Normalise so the canonical matches the
// URL people actually link to.
const path = Astro.url.pathname;
const normalizedPath = path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
const canonical = new URL(normalizedPath, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// Only claim 1200x630 for the purpose-built card. The /avatar.jpeg fallback is
// square, and declaring dimensions that don't match the file is worse than
// declaring none.
const hasCardDimensions = image === '/og.png';
---

<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Dhruv Mishra" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{
  hasCardDimensions && (
    <Fragment>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </Fragment>
  )
}

<meta name="twitter:card" content={hasCardDimensions ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

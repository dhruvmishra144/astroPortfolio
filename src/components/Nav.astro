---
import Icon from "./Icon.astro";

const navLinks = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/about-me", label: "About", icon: "user" },
  { href: "/contact", label: "Contact", icon: "envelope" },
  { href: "/resume", label: "Resume", icon: "document-text" },
] as const;

const pathname = Astro.url.pathname;
const normalizedPathname =
  pathname.endsWith("/") && pathname.length > 1
    ? pathname.slice(0, -1)
    : pathname;
---

<nav
  aria-label="Primary navigation"
  class="fixed bottom-3 left-1/2 z-30 w-[calc(100%-1.25rem)] max-w-[27rem] -translate-x-1/2"
>
  <div
    class="surface-strong flex flex-nowrap justify-between gap-2 rounded-xl px-2 py-2 sm:gap-3 sm:px-3"
  >
    {
      navLinks.map(({ href, label, icon }) => {
        const isActive = normalizedPathname === href;
        return (
          <a
            href={href}
            data-transition={isActive ? undefined : true}
            aria-current={isActive ? "page" : undefined}
            title={label}
            class:list={[
              "group flex min-w-[64px] flex-col items-center gap-1.5 rounded-xl border px-3 py-2 text-[10px] uppercase tracking-[0.28em] transition-all duration-300 sm:min-w-[72px] sm:px-4",
              isActive
                ? "pointer-events-none border-cyan-300/40 bg-cyan-400/10 text-white shadow-[0_12px_30px_rgba(34,211,238,0.15)]"
                : "border-transparent bg-transparent text-slate-400 hover:-translate-y-0.5 hover:border-cyan-300/30 hover:bg-white/10 hover:text-white",
            ]}
          >
            <span class="text-lg transition-transform duration-300 group-hover:-translate-y-0.5">
              <Icon name={icon} />
            </span>
            <span class="whitespace-nowrap text-[0.62rem] font-medium">
              {label}
            </span>
          </a>
        );
      })
    }
  </div>
</nav>

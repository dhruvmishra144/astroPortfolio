---
/**
 * Experience timeline.
 *
 * The site had no experience section anywhere, so ten years of enterprise work
 * was invisible. Only `headline` + `chips` render here; the full bullets live on
 * /resume. Both read from src/data/resume.ts so no string is duplicated.
 */
import { timeline, type TimelineRole } from '../../data/resume';

interface Props {
  roles?: TimelineRole[];
}

const { roles = timeline } = Astro.props;
---

<section id="experience" data-reveal class="page-section scroll-mt-24">
  <div class="mb-10 max-w-2xl">
    <p class="section-label">Experience</p>
    <h2 class="section-title mt-4 text-3xl text-foreground sm:text-4xl">
      Ten years, four rooms.
    </h2>
  </div>

  <ol class="grid gap-6">
    {
      roles.map((role) => (
        <li class="grid gap-3 border-t border-border pt-6 sm:grid-cols-[13rem_1fr] sm:gap-8">
          <div class="flex flex-wrap items-start gap-2">
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-subtle">
              {role.period}
            </span>
            {role.current && (
              <span class="rounded-full bg-accent px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-[color:var(--on-accent)]">
                Current
              </span>
            )}
          </div>

          <div>
            <h3 class="text-base font-semibold text-foreground">
              {role.role}
              <span class="font-normal text-accent-text"> · {role.company}</span>
            </h3>
            <p class="mt-1 text-xs uppercase tracking-[0.14em] text-subtle">{role.engagement}</p>
            <p class="mt-3 text-sm leading-7 text-muted">{role.headline}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {role.chips.map((chip) => (
                <span class="chip px-3 py-1 text-[0.7rem]">{chip}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <a
    href="/resume"
    data-transition
    class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-accent-text hover:underline"
  >
    Full detail, bullet by bullet →
  </a>
</section>

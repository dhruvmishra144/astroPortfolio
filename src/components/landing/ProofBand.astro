---
/**
 * Proof band.
 *
 * Uses StatRow (big value, small caption): a numeric metric read caption-first
 * loses the number. This also matches the LaCasa case-study hero, so both pages
 * share one treatment.
 *
 * Six tools, not thirty. The resume's full competency list is right for ATS
 * parsing and wrong for a landing page; a tool wall reads as "will do
 * anything". The long list is one click away.
 */
interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics?: Metric[];
  stack?: string[];
}

/*
 * Three, not four. The fourth was "30% faster UI sprint velocity (Aonflow)" —
 * a resume-sourced figure with no case study a visitor could check it against,
 * sitting directly beneath copy promising every number says how it was
 * measured. Removed with the Aonflow case study rather than restated.
 */
const defaultMetrics: Metric[] = [
  { value: '10+ yrs', label: 'design engineering' },
  { value: '50+', label: 'components in one governed Figma system' },
  { value: '4', label: 'products live in production' },
];

const defaultStack = [
  'Figma',
  'React / Next.js',
  'TypeScript',
  'Tailwind CSS',
  'Firebase / GCP',
  'Cloudflare',
];

const { metrics = defaultMetrics, stack = defaultStack } = Astro.props;

const spans = [
  'sm:col-span-6 lg:col-span-5',
  'sm:col-span-3 lg:col-span-4',
  'sm:col-span-3 lg:col-span-3',
];
---

<section id="proof" data-reveal class="page-section scroll-mt-24">
  <div class="mb-10 max-w-2xl">
    <p class="section-label">Proof</p>
    <h2 class="section-title mt-4 text-3xl text-foreground sm:text-4xl">
      The numbers that already happened.
    </h2>
  </div>

  {/*
    Bento: the first metric is the lead tile (widest), the others are smaller,
    then the stack tile and a resume link tile close the row. Value-first, as
    StatRow does, so a number is never read caption-first.
  */}
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-6 lg:grid-cols-12">
    {
      metrics.map((metric, i) => (
        <div
          class:list={[
            'bento-tile surface justify-between gap-8',
            i === 0 && 'surface-strong',
            // 5 + 4 + 3 = 12 on desktop for the default three metrics.
            spans[i] ?? 'sm:col-span-3 lg:col-span-4',
          ]}
        >
          <dl>
            <dt class="sr-only">{metric.label}</dt>
            <dd>
              <span
                class:list={[
                  'hero-title block text-accent-text',
                  i === 0 ? 'text-5xl sm:text-6xl' : 'text-4xl sm:text-5xl',
                ]}
              >
                {metric.value}
              </span>
              <span class="mt-2 block text-xs uppercase tracking-[0.16em] text-subtle">
                {metric.label}
              </span>
            </dd>
          </dl>
        </div>
      ))
    }

    <div class="bento-tile surface sm:col-span-6 lg:col-span-8">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-subtle">Core stack</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {stack.map((tool) => <span class="chip text-xs">{tool}</span>)}
      </div>
    </div>

    <a
      href="/resume#skills"
      class="bento-tile card-lift justify-between gap-6 bg-accent text-[color:var(--on-accent)] sm:col-span-6 lg:col-span-4"
    >
      <span class="text-xs font-bold uppercase tracking-[0.28em] opacity-90">Resume</span>
      <span class="hero-title text-xl">Full competency list →</span>
    </a>
  </div>
</section>

---
/**
 * Social proof.
 *
 * Replaces a React/Framer-Motion marquee that rendered 5 anonymous quotes 40
 * times (each quote spread twice per track, two sibling tracks, two mounted
 * instances). Every quote here renders exactly once, and every one is
 * attributable to a named person.
 *
 * `withheld` is empty by default on purpose — see the note in data/reviews.ts.
 */
import QuoteBlock from '../story/QuoteBlock.astro';
import {
  clientQuote,
  googleRating,
  googleReviews,
  withheldQuotes,
  type Review,
} from '../../data/reviews';

interface Props {
  lead?: Review;
  reviews?: Review[];
  rating?: typeof googleRating;
  withheld?: Review[];
}

const {
  lead = clientQuote,
  reviews = googleReviews,
  rating = googleRating,
  withheld = withheldQuotes,
} = Astro.props;

const tints = ['a', 'b', 'c', 'd'] as const;
---

<section id="signal" data-reveal class="page-section scroll-mt-24">
  <div class="mb-4 max-w-2xl">
    <p class="section-label">Signal</p>
    <h2 class="section-title mt-4 text-3xl text-foreground sm:text-4xl">
      What the people who paid for the work say.
    </h2>
  </div>

  <QuoteBlock quote={lead.quote} name={lead.name} role={lead.context} />

  <a
    href={rating.href}
    target="_blank"
    rel="noopener noreferrer"
    class="surface inline-flex items-center gap-3 rounded-full px-5 py-3 hover:border-accent"
  >
    <span class="text-lg font-bold text-accent-text">{rating.value} ★</span>
    <span class="text-sm font-medium text-foreground">{rating.label}</span>
    <span class="text-xs text-subtle">Read the reviews ↗</span>
  </a>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    {
      reviews.map((review, i) => (
        <figure
          class:list={[
            'surface flex flex-col rounded-[1.5rem] p-6',
            `surface-tint-${tints[i % tints.length]}`,
          ]}
        >
          <blockquote class="flex-1 text-sm leading-7 text-muted">
            “{review.quote}”
          </blockquote>
          <figcaption class="mt-6 border-t border-border pt-4">
            <span class="block text-sm font-semibold text-foreground">{review.name}</span>
            {review.context && (
              <span class="mt-1 block text-xs text-subtle">{review.context}</span>
            )}
            {review.tags && review.tags.length > 0 && (
              <span class="mt-3 flex flex-wrap gap-1.5">
                {review.tags.map((tag) => (
                  <span class="chip px-2.5 py-0.5 text-[0.65rem]">{tag}</span>
                ))}
              </span>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>

  {
    withheld.length > 0 && (
      <div class="mt-10 border-t border-border pt-8">
        <p class="text-xs leading-6 text-subtle">
          Some clients can’t be named publicly. Their quotes are included unattributed.
        </p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {withheld.map((review) => (
            <figure class="rounded-[1.25rem] border border-border p-5">
              <blockquote class="text-sm leading-7 text-muted">“{review.quote}”</blockquote>
              <figcaption class="mt-4 text-xs text-subtle">
                Client, name withheld — under NDA
                {review.context && <span> · {review.context}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )
  }
</section>

---
/**
 * Selected work.
 *
 * Card data lives in src/data/projects.ts, so this file is presentation only
 * and adding project 02 is a single object append with `featured: false` — the
 * compact branch below is already typed and waiting for it.
 *
 * The featured project is a bento cluster rather than one long card: the
 * screenshot, the summary, the problem/outcome and each metric get their own
 * tile, so the proof reads at a glance with impact visible without clicking
 * through. Every metric shown is substantiated inside the case study.
 */
import { projects } from '../../data/projects';

const arrow =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const featured = projects.filter((p) => p.featured);
const secondary = projects.filter((p) => !p.featured);
---

<section id="work" data-reveal class="page-section scroll-mt-24">
  <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div class="space-y-3">
      <p class="section-label">Selected work</p>
      <h2 class="section-title text-3xl text-foreground sm:text-4xl">
        Systems shipped, not screens decorated.
      </h2>
    </div>
    <p class="max-w-sm text-sm text-subtle">
      One shipped and maintained in production, one an independent concept. Both are judged on
      the decisions behind them — and every number says how it was measured.
    </p>
  </div>

  {/*
    12 columns on desktop, 6 on tablet, one on phones. The title is a stretched
    link, so the whole summary tile is clickable while the screenshot tile
    (a second link to the same place) stays out of the tab order and the
    accessibility tree.
  */}
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-6 lg:grid-cols-12">
    {
      featured.map((project) => (
        <>
          {project.image && (
            <a
              href={project.href}
              tabindex="-1"
              aria-hidden="true"
              class="bento-tile bento-tile-flush surface card-lift min-h-64 sm:col-span-6 lg:col-span-7 lg:row-span-2"
            >
              <img
                src={project.image}
                alt=""
                loading="lazy"
                width="1200"
                height="800"
                class="absolute inset-0 h-full w-full object-cover object-top"
              />
            </a>
          )}

          <article
            class:list={[
              'bento-tile surface-strong card-lift group sm:col-span-6',
              project.image ? 'lg:col-span-5' : 'lg:col-span-12',
            ]}
          >
            <div class="flex flex-wrap items-center gap-3">
              <span class="chip px-3 py-1 text-[0.7rem]">
                {project.index} · {project.status}
              </span>
              <span class="text-xs uppercase tracking-[0.2em] text-subtle">
                {project.category} · {project.categorySub}
              </span>
            </div>
            <h3 class="hero-title mt-5 text-2xl text-foreground sm:text-3xl">
              <a href={project.href} class="after:absolute after:inset-0 after:content-['']">
                {project.title}
              </a>
            </h3>
            <p class="mt-2 text-sm font-semibold text-accent-text">{project.forWhom}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="chip px-3 py-1 text-[0.7rem]">{tag}</span>
              ))}
            </div>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-foreground transition-transform group-hover:translate-x-1">
              Read case study
              <Fragment set:html={arrow} />
            </span>
          </article>

          <div
            class:list={[
              'bento-tile surface sm:col-span-6',
              project.tint && `surface-tint-${project.tint}`,
              project.image ? 'lg:col-span-5' : 'lg:col-span-12',
            ]}
          >
            <p class="text-xs font-bold uppercase tracking-[0.28em] text-subtle">The problem</p>
            <p class="mt-3 text-sm leading-7 text-muted">{project.problem}</p>
            <p class="mt-5 text-xs font-bold uppercase tracking-[0.28em] text-subtle">
              What shipped
            </p>
            <p class="mt-3 text-sm leading-7 text-foreground">{project.outcome}</p>
          </div>

          {project.metrics.map((metric) => (
            <div class="bento-tile surface justify-between gap-6 sm:col-span-2 lg:col-span-4">
              <dl>
                <dt class="sr-only">{metric.label}</dt>
                <dd>
                  <span class="hero-title block text-4xl text-accent-text sm:text-5xl">
                    {metric.value}
                  </span>
                  <span class="mt-2 block text-[0.7rem] uppercase tracking-[0.16em] text-subtle">
                    {metric.label}
                  </span>
                </dd>
              </dl>
            </div>
          ))}

          {project.metricsNote && (
            <p class="px-2 text-xs leading-6 text-subtle sm:col-span-6 lg:col-span-12">
              {project.metricsNote}
            </p>
          )}
        </>
      ))
    }

    {
      secondary.map((project) => (
        <a
          href={project.href}
          class:list={[
            'bento-tile surface card-lift group sm:col-span-3',
            project.tint && `surface-tint-${project.tint}`,
            project.span ?? 'lg:col-span-6',
          ]}
        >
          <div class="flex items-center gap-3">
            <span class="chip px-3 py-1 text-[0.7rem]">{project.index}</span>
            <span class="text-xs uppercase tracking-[0.2em] text-subtle">{project.category}</span>
          </div>
          <h3 class="heading-text mt-4 text-xl text-foreground">{project.title}</h3>
          <p class="mt-2 text-xs font-semibold text-accent-text">{project.forWhom}</p>
          <p class="mt-4 flex-1 text-sm leading-7 text-muted">{project.outcome}</p>
          {project.metrics[0] && (
            <p class="mt-5 border-t border-border pt-4 text-sm text-foreground">
              <span class="font-semibold text-accent-text">{project.metrics[0].value}</span>
              <span class="text-subtle"> {project.metrics[0].label}</span>
            </p>
          )}
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-foreground transition-transform group-hover:translate-x-1">
            Read case study
            <Fragment set:html={arrow} />
          </span>
        </a>
      ))
    }
  </div>
</section>

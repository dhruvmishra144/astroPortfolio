---
/**
 * ProjectGrid.astro — dark bento case-study grid for the home page.
 *
 * LaCasa Retreats is the tall feature tile; `projects` fills a 6-column bento
 * beside it and is currently empty (GoFlow/AonFlow are unlinked, not deleted,
 * pending polish). Uses the existing dark theme primitives (.surface, .chip,
 * cyan accents).
 */
const arrow =
  '<svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const feature = {
  href: "/projects/LaCasaRetreats",
  index: "01",
  category: "Booking Platform & PMS",
  categorySub: "Hospitality",
  title: "LaCasa Retreats",
  image: "/lacasa-home.png",
  impact:
    "A live booking website that grew into a property management system — built solo, end to end, to stop the same unit from being sold twice across five different channels.",
  tags: ["React 19", "Firebase", "Razorpay", "Solo build"],
  metric: { value: "17", label: "properties live" },
};

const projects = [];
---

<section id="work" class="page-section">
  <div
    class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
  >
    <div class="space-y-3">
      <p class="section-label">Selected work</p>
      <h2 class="section-title text-3xl text-white sm:text-4xl">
        Systems shipped, not screens decorated.
      </h2>
    </div>
    <p class="max-w-sm text-sm text-slate-400">
      Each engagement is measured in reliability, adoption, and time saved — not
      deliverables.
    </p>
  </div>

  <div
    class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-6 lg:auto-rows-[minmax(10rem,1fr)]"
  >
    <!-- Feature: LaCasa Retreats -->
    <a
      href={feature.href}
      data-transition
      class="surface group relative overflow-hidden rounded-[1.75rem] p-7 sm:p-9 md:col-span-2 lg:col-span-6"
    >
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-400/10 blur-3xl transition-opacity duration-500 group-hover:opacity-150"
      >
      </div>
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-14">
        <div class="relative overflow-hidden rounded-2xl border border-white/10">
          <img
            src={feature.image}
            alt={`${feature.title} preview`}
            class="h-56 w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 sm:h-72 lg:h-[26rem]"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent" />
        </div>

        <div class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <span class="chip w-fit">{feature.index} · Featured</span>
            <span class="text-[0.7rem] uppercase leading-relaxed tracking-[0.24em] text-slate-400">
              {feature.category}<span class="hidden lg:inline"> · </span><br class="lg:hidden" />{feature.categorySub}
            </span>
          </div>

          <h3 class="hero-title text-4xl text-white sm:text-5xl lg:text-6xl">
            {feature.title}
          </h3>

          <p class="max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
            {feature.impact}
          </p>

          <div class="flex flex-wrap gap-2">
            {feature.tags.map((t) => <span class="chip">{t}</span>)}
          </div>

          <div class="mt-2 flex flex-col items-start gap-4 border-t border-white/10 pt-5">
            <p class="hero-title text-3xl uppercase text-cyan-300 sm:text-4xl">
              {feature.metric.value} <span class="text-base tracking-[0.15em] sm:text-lg">{feature.metric.label}</span>
            </p>
            <span
              class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-300"
            >
              Read case study <Fragment set:html={arrow} />
            </span>
          </div>
        </div>
      </div>
    </a>

    {
      projects.map((p) => (
        <a
          href={p.href}
          data-transition
          class:list={[
            "surface group flex flex-col justify-between overflow-hidden rounded-[1.75rem] p-6 sm:p-7",
            p.span,
          ]}
        >
          <div class="flex items-start justify-between gap-3">
            <span class="text-xs font-semibold text-slate-500">{p.index}</span>
            <span class="text-right text-[0.62rem] uppercase tracking-[0.2em] text-slate-400">
              {p.category}
            </span>
          </div>
          <div class="mt-6">
            <h3 class="hero-title text-2xl text-white sm:text-3xl">
              {p.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-400">{p.impact}</p>
          </div>
          <div class="mt-5 flex items-center justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
            <span
              class="text-cyan-300 transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <Fragment set:html={arrow} />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

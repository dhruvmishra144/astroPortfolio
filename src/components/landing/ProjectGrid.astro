---
/**
 * ProjectGrid.astro — dark bento case-study grid for the home page.
 *
 * GoFlow is the tall feature tile; the rest fill a 6-column bento. Uses the
 * existing dark theme primitives (.surface, .chip, cyan accents). Real project
 * routes; copy is concise placeholder you can refine per case study.
 */
const arrow =
  '<svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const feature = {
  href: "/projects/GoFlow",
  index: "01",
  category: "AI-assisted iPaaS · Product",
  title: "GoFlow",
  impact:
    "Letting non-technical operators build and trust automated data flows across live systems — designed around preview, validation, and recovery so nothing breaks in production.",
  tags: ["Product Design", "AI-assisted mapping", "Design System"],
  metric: { value: "68%", label: "faster provisioning" },
};

const projects = [
  {
    href: "/projects/aonflow",
    index: "02",
    category: "B2B SaaS · Automation Platform",
    title: "AonFlow",
    impact:
      "A tokenized, RSC-first design system for an orchestration platform — built for data density without sacrificing responsiveness.",
    tags: ["Next.js", "React Server Components", "Tailwind CSS"],
    span: "lg:col-span-2",
  },
];
---

<section id="work" class="page-section">
  <div
    class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
  >
    <div class="space-y-3">
      <p class="section-label">Selected work</p>
      <h2 class="section-title text-3xl text-white sm:text-4xl">
        Systems shipped, not screens decorated.
      </h2>
    </div>
    <p class="max-w-sm text-sm text-slate-400">
      Each engagement is measured in reliability, adoption, and time saved — not
      deliverables.
    </p>
  </div>

  <div
    class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-6 lg:auto-rows-[minmax(10rem,1fr)]"
  >
    <!-- Feature: GoFlow -->
    <a
      href={feature.href}
      data-transition
      class="surface group relative flex flex-col justify-between overflow-hidden rounded-[1.75rem] p-7 sm:p-9 md:col-span-2 lg:col-span-4 lg:row-span-2"
    >
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-400/10 blur-3xl transition-opacity duration-500 group-hover:opacity-150"
      >
      </div>
      <div class="flex items-start justify-between">
        <span class="chip">{feature.index} · Featured</span>
        <span class="text-[0.7rem] uppercase tracking-[0.24em] text-slate-400"
          >{feature.category}</span
        >
      </div>
      <div class="my-8">
        <h3 class="hero-title text-5xl text-white sm:text-6xl">
          {feature.title}
        </h3>
        <p class="mt-5 max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
          {feature.impact}
        </p>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-wrap gap-2">
          {feature.tags.map((t) => <span class="chip">{t}</span>)}
        </div>
        <div class="text-right">
          <p class="hero-title text-3xl text-cyan-300">
            {feature.metric.value}
          </p>
          <p class="text-[0.7rem] uppercase tracking-[0.2em] text-slate-400">
            {feature.metric.label}
          </p>
        </div>
      </div>
      <span
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cyan-300"
      >
        Read case study <Fragment set:html={arrow} />
      </span>
    </a>

    {
      projects.map((p) => (
        <a
          href={p.href}
          data-transition
          class:list={[
            "surface group flex flex-col justify-between overflow-hidden rounded-[1.75rem] p-6 sm:p-7",
            p.span,
          ]}
        >
          <div class="flex items-start justify-between gap-3">
            <span class="text-xs font-semibold text-slate-500">{p.index}</span>
            <span class="text-right text-[0.62rem] uppercase tracking-[0.2em] text-slate-400">
              {p.category}
            </span>
          </div>
          <div class="mt-6">
            <h3 class="hero-title text-2xl text-white sm:text-3xl">
              {p.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-400">{p.impact}</p>
          </div>
          <div class="mt-5 flex items-center justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
            <span
              class="text-cyan-300 transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <Fragment set:html={arrow} />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

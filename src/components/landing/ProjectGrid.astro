---
/**
 * Selected work.
 *
 * Card data lives in src/data/projects.ts, so this file is presentation only
 * and adding project 02 is a single object append with `featured: false` — the
 * compact branch below is already typed and waiting for it.
 *
 * The featured card answers what / for whom / why, with impact visible without
 * clicking through. Every metric shown is substantiated inside the case study.
 */
import { projects } from '../../data/projects';

const arrow =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const featured = projects.filter((p) => p.featured);
const secondary = projects.filter((p) => !p.featured);
---

<section id="work" data-reveal class="page-section scroll-mt-24">
  <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div class="space-y-3">
      <p class="section-label">Selected work</p>
      <h2 class="section-title text-3xl text-foreground sm:text-4xl">
        Systems shipped, not screens decorated.
      </h2>
    </div>
    <p class="max-w-sm text-sm text-subtle">
      Each engagement is measured in reliability, adoption, and time saved — not deliverables.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-6">
    {
      featured.map((project) => (
        <a
          href={project.href}
          class="surface group relative overflow-hidden rounded-[1.75rem] lg:col-span-6"
        >
          <div class="flex flex-col">
            {/*
              Full-width banner rather than a side column: these are 1200x800
              desktop captures, and a narrow portrait column crops them
              mid-sentence.
            */}
            <div class="relative overflow-hidden border-b border-border">
              <img
                src={project.image}
                alt={project.imageAlt}
                loading="lazy"
                width="1200"
                height="800"
                class="h-52 w-full object-cover object-top sm:h-72 lg:h-80"
              />
            </div>

            <div class="flex flex-col p-7 sm:p-9">
              <div class="flex flex-wrap items-center gap-3">
                <span class="chip px-3 py-1 text-[0.7rem]">{project.index} · Flagship</span>
                <span class="text-xs uppercase tracking-[0.2em] text-subtle">
                  {project.category} · {project.categorySub}
                </span>
              </div>

              <h3 class="hero-title mt-5 text-2xl text-foreground sm:text-3xl">
                {project.title}
              </h3>

              <p class="mt-2 text-sm font-semibold text-accent-text">{project.forWhom}</p>

              <div class="max-w-3xl">
                <p class="mt-5 text-sm leading-7 text-muted">{project.problem}</p>
                <p class="mt-4 text-sm leading-7 text-foreground">{project.outcome}</p>
              </div>

              <div class="mt-6 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="chip px-3 py-1 text-[0.7rem]">{tag}</span>
                ))}
              </div>

              {/*
                mt-8, not mt-auto: this element draws the divider, and mt-auto
                collapses to 0 when the flex column has no free space, which put
                the rule flush against the tag chips above.
              */}
              <dl class="mt-8 grid grid-cols-1 gap-4 border-t border-border pt-6 sm:grid-cols-3">
                {project.metrics.map((metric) => (
                  <div>
                    <dt class="sr-only">{metric.label}</dt>
                    <dd>
                      <span class="hero-title block text-2xl text-accent-text sm:text-3xl">
                        {metric.value}
                      </span>
                      <span class="mt-1 block text-[0.7rem] uppercase tracking-[0.16em] text-subtle">
                        {metric.label}
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>

              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-foreground transition-transform group-hover:translate-x-1">
                Read case study
                <Fragment set:html={arrow} />
              </span>
            </div>
          </div>
        </a>
      ))
    }

    {
      secondary.map((project) => (
        <a
          href={project.href}
          class:list={[
            'surface group flex flex-col rounded-[1.75rem] p-7',
            project.tint && `surface-tint-${project.tint}`,
            project.span ?? 'lg:col-span-3',
          ]}
        >
          <div class="flex items-center gap-3">
            <span class="chip px-3 py-1 text-[0.7rem]">{project.index}</span>
            <span class="text-xs uppercase tracking-[0.2em] text-subtle">{project.category}</span>
          </div>
          <h3 class="heading-text mt-4 text-xl text-foreground">{project.title}</h3>
          <p class="mt-2 text-xs font-semibold text-accent-text">{project.forWhom}</p>
          <p class="mt-4 flex-1 text-sm leading-7 text-muted">{project.outcome}</p>
          {project.metrics[0] && (
            <p class="mt-5 border-t border-border pt-4 text-sm text-foreground">
              <span class="font-semibold text-accent-text">{project.metrics[0].value}</span>
              <span class="text-subtle"> {project.metrics[0].label}</span>
            </p>
          )}
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-foreground transition-transform group-hover:translate-x-1">
            Read case study
            <Fragment set:html={arrow} />
          </span>
        </a>
      ))
    }
  </div>
</section>

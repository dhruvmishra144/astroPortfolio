---
/**
 * "What I do" — four pillars.
 *
 * The `proof` line on each tile is the point of this section. Four pillars of
 * adjectives is what every portfolio has; one verifiable sentence each is what
 * reads as evidence. Every proof below is already backed by the LaCasa case
 * study or the resume.
 *
 * The four titles name stages of building an interface, not disciplines a
 * designer offers. The proofs did not move: they already described engineering
 * work, which is what made the old "Product thinking / UX architecture" framing
 * read as a mismatch against its own evidence.
 */

/*
 * No 01/02/03/04 markers: the headline's whole claim is that these are one job
 * seen from four sides, and sequence numbering asserts the opposite.
 */
interface Pillar {
  title: string;
  body: string;
  proof: string;
  tint: 'a' | 'b' | 'c' | 'd';
}

interface Props {
  pillars?: Pillar[];
}

const defaultPillars: Pillar[] = [
  {
    title: 'Interface architecture',
    body: 'Deciding what a screen actually has to do before anything gets drawn or typed — who is doing this, how often, and what breaks when it goes wrong.',
    proof:
      'Cut a dynamic-pricing rules engine down to two rates a month, because that is how owners actually think.',
    tint: 'a',
  },
  {
    title: 'Design infrastructure',
    body: 'Tokens, components, and the governance that keeps them honest — so it is still one system after the third team starts building on it.',
    proof: 'Governed a 50+ component Figma system with tokens across multi-tenant dashboards.',
    tint: 'b',
  },
  {
    title: 'Systems integration',
    body: 'The model underneath the screens: data shapes, sources of truth, and trade-offs that get written down instead of discovered later.',
    proof:
      'Five booking channels reconciled into one calendar, with the manual-logging ceiling documented, not hidden.',
    tint: 'c',
  },
  {
    title: 'Production engineering',
    body: 'React, Next.js, TypeScript, Tailwind. I ship the front-end myself, which is why the design that ships is the design that was decided.',
    proof: 'Booking platform and PMS built solo, live and maintained.',
    tint: 'd',
  },
];

const { pillars = defaultPillars } = Astro.props;
---

<section id="approach" data-reveal class="page-section scroll-mt-24">
  <div class="mb-10 max-w-2xl">
    <p class="section-label">What I do</p>
    <h2 class="section-title mt-4 text-3xl text-foreground sm:text-4xl">
      Four things, and they are the same job.
    </h2>
  </div>

  {/*
    Bento, staggered 7/5 then 5/7 so the four pillars read as a composition
    instead of a row of equal cards. Spans are positional, so they apply to
    whatever four pillars are passed in.
  */}
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-6 lg:grid-cols-12">
    {
      pillars.map((pillar, i) => (
        <article
          class:list={[
            'bento-tile surface sm:col-span-3',
            `surface-tint-${pillar.tint}`,
            [0, 3].includes(i % 4) ? 'lg:col-span-7' : 'lg:col-span-5',
          ]}
        >
          <h3 class="heading-text text-lg text-foreground sm:text-xl">{pillar.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-7 text-muted">{pillar.body}</p>
          <p class="mt-5 border-t border-border pt-4 text-xs leading-6 text-subtle">
            {pillar.proof}
          </p>
        </article>
      ))
    }
  </div>
</section>

---
/**
 * "What I do" — four pillars.
 *
 * The `proof` line on each tile is the point of this section. Four pillars of
 * adjectives is what every portfolio has; one verifiable sentence each is what
 * reads as evidence. Every proof below is already backed by the LaCasa case
 * study or the resume.
 */

interface Pillar {
  index: string;
  title: string;
  body: string;
  proof: string;
  tint: 'a' | 'b' | 'c' | 'd';
}

interface Props {
  pillars?: Pillar[];
}

const defaultPillars: Pillar[] = [
  {
    index: '01',
    title: 'Product thinking',
    body: 'Framing the actual problem before anyone opens Figma — who is doing this, how often, and what breaks when it goes wrong.',
    proof:
      'Cut a dynamic-pricing rules engine down to two rates a month, because that is how owners actually think.',
    tint: 'a',
  },
  {
    index: '02',
    title: 'UX architecture',
    body: 'Information architecture, flows, and states — including the empty, error, and mid-call ones that decide whether a tool survives contact with real work.',
    proof: 'Governed a 50+ component Figma system with tokens across multi-tenant dashboards.',
    tint: 'b',
  },
  {
    index: '03',
    title: 'Systems thinking',
    body: 'Designing the model underneath the screens: data shapes, sources of truth, and trade-offs that get written down instead of discovered later.',
    proof:
      'Five booking channels reconciled into one calendar, with the manual-logging ceiling documented, not hidden.',
    tint: 'c',
  },
  {
    index: '04',
    title: 'Technical execution',
    body: 'React, Next.js, TypeScript, Tailwind — I build production front-end, so the design that ships is the design that was decided.',
    proof: 'Booking platform and PMS built solo, live and maintained.',
    tint: 'd',
  },
];

const { pillars = defaultPillars } = Astro.props;
---

<section id="approach" data-reveal class="page-section scroll-mt-24">
  <div class="mb-10 max-w-2xl">
    <p class="section-label">What I do</p>
    <h2 class="section-title mt-4 text-3xl text-foreground sm:text-4xl">
      Four things, and they are the same job.
    </h2>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      pillars.map((pillar) => (
        <article
          class:list={[
            'surface flex flex-col rounded-[1.5rem] p-6',
            `surface-tint-${pillar.tint}`,
          ]}
        >
          <span class="text-xs font-bold uppercase tracking-[0.28em] text-accent-text">
            {pillar.index}
          </span>
          <h3 class="heading-text mt-4 text-lg text-foreground">{pillar.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-7 text-muted">{pillar.body}</p>
          <p class="mt-5 border-t border-border pt-4 text-xs leading-6 text-subtle">
            {pillar.proof}
          </p>
        </article>
      ))
    }
  </div>
</section>

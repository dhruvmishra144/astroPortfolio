---
/**
 * SiteNav.astro — the site's only navigation: brand · links · theme · Ask ⌘K.
 *
 * Was a two-tab WORK/LIFE segmented control that duplicated the old bottom
 * dock (Nav.astro, now removed). These are page navigations, not tabs, so they
 * are plain links with aria-current rather than role="tab"/aria-selected —
 * nothing toggles in place, and the tablist semantics actively misled
 * screen readers.
 */
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  showThemeToggle?: boolean;
}

const { showThemeToggle = true } = Astro.props;

const pathname = Astro.url.pathname;
const p =
  pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const links = [
  { href: '/', label: 'Work', match: (path: string) => path === '' || path === '/' || path.startsWith('/projects') || path.startsWith('/design-systems') },
  { href: '/about-me', label: 'About', match: (path: string) => path === '/about-me' },
  { href: '/resume', label: 'Resume', match: (path: string) => path === '/resume' },
  { href: '/contact', label: 'Contact', match: (path: string) => path === '/contact' },
];

const items = links.map((link) => ({ ...link, active: link.match(p) }));
---

<header class="site-nav">
  <div class="site-nav__inner">
    <div class="site-nav__side">
      <a href="/" data-transition class="site-nav__brand" aria-label="Dhruv Mishra — home">
        {/*
          Inlined rather than <img src="/logo.svg"> because that file is
          hardcoded fill:#fff and vanishes on a light background. currentColor
          makes the mark follow the theme.
        */}
        <svg
          viewBox="0 0 110 60"
          class="h-8 w-8 text-foreground"
          fill="currentColor"
          role="img"
          aria-hidden="true"
        >
          <path
            d="M93.1.6l-18.7,25.5L55.2.6h-6.9s-31.4,0-31.4,0c6.4,0,11.9,1.3,16.6,3.8,4.7,2.5,8.3,6,10.9,10.4,2.6,4.4,3.9,9.5,3.9,15.2s-1.3,10.8-3.9,15.2c-2.6,4.5-6.2,7.9-10.9,10.5-4.7,2.5-10.2,3.8-16.6,3.8h38.6V20.7l17.8,23.8h1.6l17.8-22.9v38h12.3V.6h-11.9Z"
          ></path>
          <path
            d="M27.2,46.4c2.8-1.6,5-3.7,6.5-6.6,1.6-2.8,2.3-6.1,2.3-9.9s-.8-7.2-2.3-10c-1.6-2.8-3.7-5-6.5-6.5-2.8-1.5-6.1-2.3-10-2.3h-7.3v37.5h7.3c3.8,0,7.2-.8,10-2.3Z"
          ></path>
        </svg>
        <span class="hidden text-sm font-semibold text-foreground sm:block">Dhruv Mishra</span>
      </a>
    </div>

    <nav class="site-nav__links" aria-label="Primary">
      {
        items.map((item) => (
          <a
            href={item.href}
            data-transition={item.active ? undefined : true}
            aria-current={item.active ? 'page' : undefined}
            class:list={['site-nav__link', item.active && 'site-nav__link--active']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-nav__side site-nav__side--end">
      {showThemeToggle && <ThemeToggle />}
      <button type="button" class="site-nav__ask" data-command-open aria-label="Open command palette">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 5h16v11H8l-4 3V5z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
        <span class="hidden sm:inline">Ask Dhruv</span>
        <kbd>⌘K</kbd>
      </button>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: 0.9rem;
  }
  .site-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface-strong);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 1px 0 var(--border);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .site-nav.is-scrolled::before {
    opacity: 1;
  }
  .site-nav__inner {
    width: min(100%, 82rem);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 1.75rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-nav__side {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 0;
  }
  .site-nav__side--end {
    justify-content: flex-end;
  }
  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-nav__links {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--surface-strong);
    border: 1px solid var(--border);
    backdrop-filter: blur(18px);
    box-shadow: var(--shadow-elevated);
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--subtle);
    white-space: nowrap;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }
  .site-nav__link:hover {
    color: var(--foreground);
  }
  .site-nav__link--active {
    color: var(--on-accent);
    background: var(--accent);
    box-shadow: 0 10px 26px var(--accent-soft);
  }

  .site-nav__ask {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: var(--surface-strong);
    border: 1px solid var(--border);
    backdrop-filter: blur(18px);
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      color 180ms ease;
    width: max-content;
  }
  .site-nav__ask:hover {
    border-color: var(--accent);
    color: var(--foreground);
  }
  .site-nav__ask kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    padding: 0.12rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--subtle);
  }

  /* Below ~900px the four links plus both right-hand controls stop fitting on
     one row, so the link row moves under the brand and scrolls if needed. */
  @media (max-width: 900px) {
    .site-nav__inner {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }
    .site-nav__links {
      order: 3;
      flex: 1 1 100%;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .site-nav__links::-webkit-scrollbar {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .site-nav__brand span {
      display: none;
    }
    .site-nav__link {
      padding: 0.5rem 0.8rem;
      letter-spacing: 0.1em;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  if (nav) {
    const updateScrolled = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }
</script>

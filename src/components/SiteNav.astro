---
/**
 * SiteNav.astro — top chrome: brand · WORK/LIFE toggle · Ask ⌘K.
 *
 * Replaces the old Header. The centred segmented toggle mirrors the reference:
 * WORK covers the landing + case studies, LIFE is the /about-me story page.
 * The Ask button carries [data-command-open] so it opens the ⌘K palette.
 */
const pathname = Astro.url.pathname;
const p = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const isLife = p === '/about-me';
const isWork = !isLife; // landing, projects, contact, resume all read as "Work"
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a href="/" data-transition class="site-nav__brand" aria-label="Dhruv Mishra — home">
      <img src="/logo.svg" width="36" height="36" alt="" class="h-8 w-8" />
      <span class="hidden text-sm font-semibold text-white sm:block">Dhruv Mishra</span>
    </a>

    <div class="site-nav__toggle" role="tablist" aria-label="Section">
      <a
        href="/"
        data-transition={isWork ? undefined : true}
        role="tab"
        aria-selected={isWork}
        class:list={['site-nav__tab', isWork && 'site-nav__tab--active']}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.7"></rect>
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.7"></path>
        </svg>
        Work
      </a>
      <a
        href="/about-me"
        data-transition={isLife ? undefined : true}
        role="tab"
        aria-selected={isLife}
        class:list={['site-nav__tab', isLife && 'site-nav__tab--active']}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3l2.2 5.6L20 9.2l-4.4 3.8 1.4 5.8L12 15.8 7 18.8l1.4-5.8L4 9.2l5.8-.6L12 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
        </svg>
        Life
      </a>
    </div>
    div
    <button type="button" class="site-nav__ask" data-command-open aria-label="Open command palette">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 5h16v11H8l-4 3V5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      </svg>
      <span class="hidden sm:inline">Ask Dhruv</span>
      <kbd>⌘K</kbd>
    </button>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: 0.9rem;
  }
  .site-nav__inner {
    width: min(100%, 82rem);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 1.75rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 0;
  }

  /* Centered segmented toggle */
  .site-nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgba(10, 18, 33, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.18);
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 50px rgba(2, 8, 23, 0.4);
  }
  .site-nav__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(148 163 184);
    transition: color 180ms ease, background-color 180ms ease;
  }
  .site-nav__tab:hover {
    color: #fff;
  }
  .site-nav__tab--active {
    color: #061018;
    background: linear-gradient(135deg, #4dd7ff, rgba(34, 211, 238, 0.9));
    box-shadow: 0 10px 26px rgba(34, 211, 238, 0.28);
  }

  /* Ask button */
  .site-nav__ask {
    flex: 1 1 0;
    justify-content: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: rgba(10, 18, 33, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.18);
    backdrop-filter: blur(18px);
    color: rgb(226 232 240);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 180ms ease, color 180ms ease;
    width: max-content;
  }
  .site-nav__ask:hover {
    border-color: rgba(77, 215, 255, 0.4);
    color: #fff;
  }
  .site-nav__ask kbd {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.62rem;
    padding: 0.12rem 0.4rem;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 6px;
    color: rgb(148 163 184);
  }

  @media (max-width: 640px) {
    .site-nav__brand span {
      display: none;
    }
    .site-nav__tab {
      padding: 0.5rem 0.85rem;
      letter-spacing: 0.12em;
    }
  }
</style>

---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AuroraWaves from '../components/AuroraWaves.astro';
import CommandPalette from '../components/CommandPalette.svelte';
import CustomCursor from '../components/CustomCursor.svelte';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Product design and front-end aligned UX systems for scalable digital products.',
} = Astro.props;

const fullTitle = title ? `${title} | Dhruv Mishra` : 'Dhruv Mishra | UX/UI Designer';

const pathname = Astro.url.pathname;
const normalizedPathname =
  pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;
const showFooter = normalizedPathname !== '/contact';

const bootBars = Array.from({ length: 28 });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="UX/UI design, product design, design systems, front-end development" />
    <meta name="author" content="Dhruv Mishra" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/icon.png" />
  </head>
  <body class="bg-background text-foreground antialiased">
    <a class="skip-link" href="#content">Skip to content</a>
    <CustomCursor client:idle />
    <div class="portfolio-background relative min-h-screen w-full isolate bg-slate-950">
      <div aria-hidden="true" class="portfolio-background__motion fixed inset-0 z-0 pointer-events-none"></div>
      <AuroraWaves />
      <div class="relative z-10">
        <div
          id="banner-1"
          class="boot min-h-screen h-screen bg-background z-30 fixed top-0 left-0 w-full flex flex-col items-center justify-center overflow-hidden"
        >
          <div class="boot-grid pointer-events-none absolute inset-0 flex justify-between" aria-hidden="true">
            {bootBars.map(() => <span class="boot-bar" />)}
          </div>
          <div class="boot-sweep pointer-events-none absolute left-0 top-1/2 h-px w-full" aria-hidden="true"></div>

          <div class="relative z-10 flex flex-col items-center gap-3 text-center">
            <div class="flex flex-col items-center gap-2">
              <span class="boot-mark font-display text-lg tracking-[0.2em] text-white">DM</span>
              <span class="boot-dot h-1.5 w-1.5 rounded-full bg-cyan-300"></span>
            </div>
            <p class="boot-name text-sm font-semibold uppercase tracking-[0.4em] text-white">
              Dhruv Mishra
            </p>
            <p class="boot-role text-[10px] uppercase tracking-[0.32em] text-cyan-300/80">
              Product Design · UX Strategy · Front-End
            </p>
            <div class="boot-status mt-6 flex flex-col items-center gap-1">
              <span class="text-[10px] uppercase tracking-[0.32em] text-slate-400">System Ready</span>
              <span class="boot-pct text-xs font-semibold text-cyan-300">100%</span>
            </div>
          </div>
        </div>
        <SiteNav />
        <slot />
        {showFooter && <Footer />}
        <Nav />
      </div>
    </div>
    <CommandPalette client:idle />
    <script>
      import { initPageTransitions } from '../scripts/transitions';

      initPageTransitions();
    </script>
  </body>
</html>

<style>
  .boot-bar {
    flex: 1;
    height: 100%;
    transform: scaleY(0);
    transform-origin: center;
    background: linear-gradient(180deg, transparent, rgba(77, 215, 255, 0.35) 45%, transparent 90%);
  }

  .boot-sweep {
    transform: scaleX(0);
    transform-origin: center;
    background: linear-gradient(90deg, transparent, rgba(77, 215, 255, 0.9), transparent);
  }

  .boot-mark,
  .boot-dot,
  .boot-name,
  .boot-role,
  .boot-status {
    opacity: 0;
  }
</style>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/landing/Hero.astro';
import ProjectGrid from '../components/landing/ProjectGrid.astro';
import Capabilities from '../components/landing/Capabilities.astro';
import ProofBand from '../components/landing/ProofBand.astro';
import ExperienceTimeline from '../components/landing/ExperienceTimeline.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import AboutTeaser from '../components/landing/AboutTeaser.astro';
---

<Base description="Product designer and front-end engineer for complex SaaS, AI and data products. Ten years turning enterprise software into products people will actually open.">
  <main id="content" class="page-shell overflow-x-hidden pb-24">
    <Hero />
    <ProjectGrid />
    <Capabilities />
    <ProofBand />
    <ExperienceTimeline />
    <Testimonials />
    <AboutTeaser />
  </main>
</Base>

<script>
  import { initReveal } from '../scripts/reveal';

  initReveal({ heroSelector: '[data-hero]', revealSelector: '[data-reveal]' });
</script>

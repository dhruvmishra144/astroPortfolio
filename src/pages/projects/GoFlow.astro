---
import Base from '../../layouts/Base.astro';
import Section from '../../components/aonflow/Section.astro';
import StatRow from '../../components/story/StatRow.astro';
import StoryBeat from '../../components/story/StoryBeat.astro';
import BeforeAfter from '../../components/story/BeforeAfter.astro';
import Bullet from '../../components/goflow/Bullet.astro';
import SubHeading from '../../components/goflow/SubHeading.astro';
import DataAnalysisChart from '../../components/goflow/DataAnalysisChart.svelte';
import CompetitiveFeatureMatrix from '../../components/goflow/CompetitiveFeatureMatrix.astro';
import UserEmpathyMap from '../../components/goflow/UserEmpathyMap.astro';

const stack = ['Independent concept', 'Safety-first design', 'No production metrics'];

const stats = [
  { value: '88%', label: 'First-run completion (prototype)' },
  { value: '7', label: 'Design pivots' },
  { value: 'Solo', label: 'Concept & research' },
];

const disclosureLegend = [
  { tag: 'OBS', title: 'Observation from experience', copy: 'Patterns I saw firsthand, described at a non-confidential level.' },
  { tag: 'AUD', title: 'Public product audit', copy: 'Based on public sites, demos, docs, and competitor material.' },
  { tag: 'CPT', title: 'Independent concept', copy: 'Design work developed after leaving the company.' },
  { tag: 'HYP', title: 'Projected — not measured', copy: 'A hypothesis for a future pilot, not production performance.' },
];

const researchInputs = [
  'Domain expertise · firsthand iPaaS experience',
  'Competitive teardowns · 5 tools',
  'Review mining · 200+ public reviews',
  'Heuristic evaluation + persona simulation · 3 passes',
];

const invalidatedAssumptions = [
  { title: 'Faster setup is the main lever', body: 'Setup speed barely moved willingness to run. Recoverability did.' },
  { title: 'Users distrust AI suggestions', body: 'They trust AI if it shows its reasoning. Hidden automation is the problem.' },
  { title: 'A confirm dialog is enough safety', body: 'Only a visible undo path changed behavior.' },
];

const flowSteps = [
  { number: '01', title: 'Choose outcome', fear: 'Which connector do I even pick?', system: 'Pairs optimal connectors and auth flow from the chosen outcome.' },
  { number: '02', title: 'Connect systems', fear: 'Will auth break something?', system: 'Guided OAuth with scoped tokens and read-first checks.' },
  { number: '03', title: 'Map data', fear: 'I don’t know where this ends up.', system: 'Source-target visibility with sample records and why labels.' },
  { number: '04', title: 'Preview / dry run', fear: 'What actually changes?', system: 'Before/after diff plus a plain-language summary of effects.' },
  { number: '05', title: 'Risk checkpoint', fear: 'What’s the blast radius?', system: 'Cardinality and delete-risk detection with estimates.' },
  { number: '06', title: 'Run flow', fear: 'What if it breaks mid-run?', system: 'Versioned execution with real-time anomaly detection.' },
  { number: '07', title: 'Monitor / errors', fear: 'How bad is it?', system: 'Operator-readable errors and a run-level impact summary.' },
  { number: '08', title: 'Recovery / rollback', fear: 'Can I undo this?', system: 'Immutable change sets plus self-healing suggestions, scoped to one run.' },
];

const pivots = [
  {
    tag: '01 · Setup',
    tension: 'Template selection and auth drove high abandonment — operators froze picking a connector before they’d even started.',
    call: 'Flip the flow from "select a connector" to "select an outcome," and pair the best connectors automatically.',
    result: 'Completion improved from ~60% to 88% in prototype evaluation; setup time moved from ~18 min to ~10–11 min.',
  },
  {
    tag: '02 · Setup',
    tension: 'Auto-mapping felt opaque and hard to trust — operators couldn’t see why a field went where it did.',
    call: 'Show a "why" explanation, preview transforms on sample records, and expose ghost fields before commit.',
    result: 'Users stopped fearing AI help and started fearing hidden AI help.',
  },
  {
    tag: '03 · Risk',
    tension: 'Cardinality mistakes (one-to-many, many-to-one) caused silent duplicates and overwrites.',
    call: 'Flag cardinality risk at mapping time, show blast-radius estimates, and force explicit merge rules.',
    result: 'Removed most silent cardinality errors in concept testing.',
  },
  {
    tag: '04 · Execution',
    tension: 'Failed runs showed cryptic API errors with no next step.',
    call: 'Translate errors into operator language, add a run-level impact summary, and make it exportable.',
    result: 'Errors became opportunities to demonstrate reliability instead of dead ends.',
  },
  {
    tag: '05 · Execution',
    tension: 'There was no standard way to undo an unwanted run.',
    call: 'Make every run produce an immutable change set, then scope rollback to exactly that run.',
    result: 'Recovery became self-serve instead of support-led.',
  },
  {
    tag: '06 · Risk',
    tension: 'Delete actions were too dangerous to treat as ordinary field mappings.',
    call: 'Default to soft delete, gate hard delete behind explicit intent and a preview, route suspicious cases to a checkpoint.',
    result: 'Deletes became auditable operations instead of silent risk.',
  },
  {
    tag: '07 · Recovery',
    tension: 'Autonomous recovery without visibility would break trust, not build it.',
    call: 'Detect failures, propose fixes with predicted outcomes, require confirmation, and log every action.',
    result: 'Suggest-only automation preserved trust while still reducing manual recovery work.',
  },
];

const outcomeRows = [
  { label: 'First-run completion', before: '~60%', after: '88% (prototype)' },
  { label: 'Median setup time', before: '~18 min', after: '~10–11 min (prototype)' },
  { label: 'First-run config errors', before: 'High baseline', after: '~50% fewer (prototype)' },
  { label: 'Recovery from failed runs', before: 'Support-led', after: '~35% faster, self-serve (projected)' },
  { label: 'Self-serve recovery rate', before: '~0%', after: '~85% (projected)' },
];

const proofPoints = [
  'Risk-aware design for automation can translate governance concerns into concrete product mechanics.',
  'Governance can be expressed through observability, auditability, reversibility, and controlled autonomy.',
  'Trade-offs between activation speed, infrastructure cost, and safety can be resolved with measurable outcomes.',
  'One clear user observation can reframe an entire product strategy when validated with structured testing.',
  'Reusable design primitives work better than one-off features when the underlying risk model repeats.',
  'Every design decision here ties back to a measurable behavior or a traceable safeguard.',
];

const deliverables = ['Figma service blueprint', 'Risk heatmaps', 'Journey maps with emotional curve', 'Decision logs', 'User empathy maps and research synthesis'];
const shipList = ['Pre-built connectors with outcome onboarding', 'AI data mapping', 'Cardinality safeguards', 'Version control and rollback', 'Error handling and reporting', 'Hard / soft delete handling', 'Self-healing agent'];
---

<Base
  title="GoFlow Case Study"
  description="An independent UX case study for GoFlow, an AI-powered iPaaS concept focused on safer execution, reversibility, and trust-first automation for SMB operators."
>
  <main id="content" class="page-shell pb-24 pt-20">
    <section class="page-section max-w-4xl space-y-7">
      <div class="flex flex-wrap gap-2">
        {stack.map((item) => <span class="chip">{item}</span>)}
      </div>

      <div class="space-y-5">
        <p class="section-label">Independent concept · Not shipped</p>
        <h1 class="hero-title text-balance text-5xl leading-[0.95] text-foreground sm:text-6xl lg:text-7xl">
          The problem was never understanding. It was undoing.
        </h1>
        <p class="max-w-2xl text-base leading-8 text-muted sm:text-lg">
          A self-initiated strategy and UX redesign for an AI-powered iPaaS, informed by firsthand
          iPaaS experience — focused on helping non-technical SMB operators create, run, monitor,
          and recover integrations without API or schema literacy.
        </p>
      </div>

      <StatRow stats={stats} />

      <div class="rounded-2xl border-l-2 border-accent bg-surface p-6 text-sm leading-7 text-muted sm:text-base">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent-text">Context and disclosure — please read first</p>
        <p class="mt-3">
          I worked at an iPaaS company until early 2026, where I gained firsthand exposure to the
          product, integration workflows, and the challenges non-technical operators face. After
          leaving, I revisited the opportunity independently. This redesign was <strong class="text-foreground">not commissioned,
          approved, implemented, or shipped</strong> by that company. Any findings below are my own
          analysis, prototype evaluation, or clearly labeled hypotheses. "GoFlow" is my name for this
          concept, and the screens use fictional sample data.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {disclosureLegend.map((item) => (
            <div class="rounded-xl border border-border bg-surface-strong p-3">
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-text">{item.tag} — {item.title}</p>
              <p class="mt-1 text-xs leading-5 text-subtle">{item.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <StoryBeat eyebrow="The problem" headline="SMBs didn't fail at setup. They froze at Run.">
      <p>
        Could an iPaaS feel dramatically safer than today's tools without raising setup time, infra
        cost, or price point? Competitors optimized for setup speed, then pushed risk onto users at
        the exact moment it mattered most: live execution. Hidden logs, unclear failure states,
        manual rollback if any, and deletes treated like ordinary field mappings.
      </p>
      <p>
        The reframe: SMB operators could configure integrations — they didn't trust themselves to
        safely run or recover them. That moves the product problem from setup speed to execution
        safety, which is why this work focuses on previewability, blast-radius clarity,
        recoverability, and accountability rather than another visual builder.
      </p>
    </StoryBeat>

    <Section eyebrow="Research" title="No production users, so the evidence had to come from elsewhere">
      <p>
        With no live accounts to study, I treated this as high-fidelity concept validation instead
        of a field study: firsthand domain knowledge, competitor teardowns, review mining, and
        repeated prototype walks with evidence-grounded SMB Ops/RevOps personas built from that
        research, not invented from scratch.
      </p>
      <div class="flex flex-wrap gap-2">
        {researchInputs.map((item) => <span class="chip">{item}</span>)}
      </div>
      <div class="rounded-2xl border border-border bg-surface p-5">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent-text">The turning point</p>
        <p class="mt-3 text-base leading-8 sm:text-lg">
          A participant configured a HubSpot-to-QuickBooks invoice sync without training. Every
          interaction was smooth — until they hovered over Run and held. <em>"I get it. I just don't
          know how to undo this if it goes wrong."</em>
        </p>
      </div>
      <DataAnalysisChart client:visible />
    </Section>

    <StoryBeat eyebrow="What this validated" headline="Recoverability moved behavior. Speed didn't.">
      <div class="grid gap-4 sm:grid-cols-1">
        {invalidatedAssumptions.map((item) => (
          <div class="rounded-2xl border border-border bg-surface p-4">
            <p class="text-sm font-semibold text-foreground">{item.title}</p>
            <p class="mt-1 text-sm leading-6 text-muted">{item.body}</p>
          </div>
        ))}
      </div>
    </StoryBeat>

    <div class="page-section">
      <UserEmpathyMap />
    </div>

    <Section eyebrow="Market" title="Everyone raced setup speed. Execution safety was open ground.">
      <p>
        Six competitors were scored across eight execution-safety dimensions. The honest takeaway:
        competitors are at parity or ahead on setup speed and connector breadth. GoFlow's proposed
        advantage sits entirely in the dimensions that show up after Run — rollback, error
        transparency, delete safety, and auditability.
      </p>
      <CompetitiveFeatureMatrix />
    </Section>

    <StoryBeat eyebrow="Flow" headline="Eight steps, built to flatten the anxiety spike at Run.">
      <p>
        Each step pairs a named user fear with the specific system behavior designed to answer it —
        so confidence builds continuously instead of collapsing right before the one action that
        actually matters.
      </p>
      <div class="grid gap-3">
        {flowSteps.map((step) => (
          <div class="flex gap-4 rounded-2xl border border-border bg-surface p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent-text">
              {step.number}
            </span>
            <div>
              <p class="text-sm font-semibold text-foreground">{step.title}</p>
              <p class="mt-1 text-sm leading-6 text-muted">
                <span class="text-subtle">Fear: "{step.fear}"</span> — {step.system}
              </p>
            </div>
          </div>
        ))}
      </div>

      <article class="rounded-2xl border border-border bg-surface p-5 sm:p-6">
        <div class="mb-3 flex items-center justify-between text-[0.65rem] font-semibold uppercase tracking-[0.32em] text-subtle">
          <span>Confident</span>
          <span>Anxious</span>
        </div>

        <svg viewBox="0 0 900 330" class="h-[280px] w-full">
          <defs>
            <linearGradient id="goflow-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="rgba(47,98,255,0.24)" />
              <stop offset="100%" stop-color="rgba(47,98,255,0.02)" />
            </linearGradient>
          </defs>

          <line x1="60" y1="62" x2="60" y2="255" stroke="#e2e8f0" stroke-width="2" />
          <line x1="60" y1="255" x2="835" y2="255" stroke="#e2e8f0" stroke-width="2" />
          <line x1="60" y1="134" x2="835" y2="134" stroke="#eef2f7" stroke-width="2" />

          <polyline
            fill="url(#goflow-fill)"
            stroke="rgba(47,98,255,0.75)"
            stroke-width="4"
            points="100,105 240,125 380,138 520,188 660,165 790,95 790,255 100,255"
          />
          <polyline
            fill="none"
            stroke="#94a3b8"
            stroke-dasharray="8 8"
            stroke-width="3"
            points="100,112 240,135 380,148 520,188 660,194 790,192"
          />

          {[
            [100, 105, '#2f62ff'],
            [240, 125, '#2f62ff'],
            [380, 138, '#2f62ff'],
            [520, 188, '#dc2626'],
            [660, 165, '#2f62ff'],
            [790, 95, '#16a34a'],
          ].map(([cx, cy, color]) => (
            <circle cx={cx} cy={cy} r="6" fill={color} />
          ))}

          <text x="34" y="85" fill="#cbd5e1" font-size="12" font-weight="600">Confident</text>
          <text x="34" y="188" fill="#cbd5e1" font-size="12" font-weight="600">Anxious</text>
          <text x="500" y="205" fill="#dc2626" font-size="12" font-weight="700">Low point</text>
        </svg>

        <div class="mt-4 grid grid-cols-2 gap-2 text-center text-xs text-subtle sm:grid-cols-6">
          {['Choose outcome', 'Map data', 'Preview', 'Press Run', 'Error / failure', 'Rollback / recover'].map((label) => (
            <span class="rounded-full bg-surface-strong px-3 py-2">{label}</span>
          ))}
        </div>
      </article>
    </StoryBeat>

    <Section eyebrow="Design pivots" title="Seven decisions behind the completion-rate jump">
      <div class="grid gap-4">
        {pivots.map((pivot, index) => (
          <article class="rounded-2xl border border-border bg-surface p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-text">{pivot.tag}</p>
            <p class="mt-3 text-sm leading-7 text-muted"><strong class="text-foreground">Tension:</strong> {pivot.tension}</p>
            <p class="mt-2 text-sm leading-7 text-muted"><strong class="text-foreground">Call:</strong> {pivot.call}</p>
            <p class="mt-2 text-sm leading-7 text-subtle"><strong class="text-foreground">Result:</strong> {pivot.result}</p>
          </article>
        ))}
      </div>
    </Section>

    <StoryBeat eyebrow="Fidelity" headline="Trust before polish.">
      <p>
        Risk, preview, and recovery were proven structurally before any visual polish existed —
        flow-level annotations first, then low-fidelity grey boxes sequencing mapping → preview →
        recovery, then mid-fidelity with real copy and documented edge cases, and only then visual
        design. Hierarchy had to answer the risk question first; explainability beat minimalism, and
        familiarity beat novelty.
      </p>
    </StoryBeat>

    <Section eyebrow="Validation" title="Prototype evidence, labeled as exactly that">
      <p>
        These figures come from moderated evaluation of the prototype with evidence-grounded
        personas — not from production traffic. This concept was never shipped and had no live
        accounts. Figures marked <em>prototype</em> are from a measured evaluation run; figures
        marked <em>projected</em> are what a pilot would still need to confirm.
      </p>
      <BeforeAfter rows={outcomeRows} />
    </Section>

    <StoryBeat eyebrow="What this proves" headline="The strategy work behind the interface.">
      <ul class="space-y-3">
        {proofPoints.map((point) => <Bullet>{point}</Bullet>)}
      </ul>
    </StoryBeat>

    <Section eyebrow="Deliverables" title="Outputs and feature ship list v1">
      <div class="grid gap-6 lg:grid-cols-2">
        <div>
          <SubHeading>Core design outputs</SubHeading>
          <ul class="mt-4 space-y-3">
            {deliverables.map((item) => <Bullet>{item}</Bullet>)}
          </ul>
        </div>
        <div>
          <SubHeading>Feature ship list v1</SubHeading>
          <ul class="mt-4 space-y-3">
            {shipList.map((item) => <Bullet>{item}</Bullet>)}
          </ul>
        </div>
      </div>
    </Section>
  </main>
</Base>

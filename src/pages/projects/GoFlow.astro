---
import Base from '../../layouts/Base.astro';
import Section from '../../components/goflow/Section.astro';
import SubHeading from '../../components/goflow/SubHeading.astro';
import Bullet from '../../components/goflow/Bullet.astro';
import DataAnalysisChart from '../../components/goflow/DataAnalysisChart.svelte';
import CompetitiveFeatureMatrix from '../../components/goflow/CompetitiveFeatureMatrix.astro';
import UserEmpathyMap from '../../components/goflow/UserEmpathyMap.astro';

const atAGlance = [
  {
    label: 'Role',
    value: 'Sole designer - problem framing, trust model, end-to-end concept',
  },
  {
    label: 'Type',
    value: 'Independent post-employment redesign concept - not shipped',
  },
  {
    label: 'Timeline',
    value: 'Self-directed after my employment ended',
  },
  {
    label: 'Team',
    value: 'Solo - no company team involved',
  },
  {
    label: 'Platform',
    value: 'Concept web app targeting Firebase / NoSQL-class backend',
  },
  {
    label: 'Method',
    value: 'Double Diamond plus a fidelity ladder in development',
  },
];

const disclosureLegend = [
  {
    tag: 'OBS',
    title: 'Observation from experience',
    copy: 'Patterns I saw firsthand, described at a non-confidential level.',
  },
  {
    tag: 'AUD',
    title: 'Public product audit',
    copy: 'Based on public sites, demos, docs, and competitor material.',
  },
  {
    tag: 'CPT',
    title: 'Independent concept',
    copy: 'Design work developed after leaving the company.',
  },
  {
    tag: 'HYP',
    title: 'Projected - not measured',
    copy: 'A hypothesis for a future pilot, not production performance.',
  },
];

const snapshotCards = [
  {
    label: 'Product',
    value: 'GoFlow - agentic-AI iPaaS for SMBs',
  },
  {
    label: 'Role',
    value: 'Sole designer - strategy, trust model, end-to-end concept',
  },
  {
    label: 'Key insight',
    value: 'The blocker was "I can\'t recover," not "I don\'t understand."',
  },
  {
    label: 'Scope',
    value: 'Independent concept + prototype evaluation - not shipped',
  },
];

const roleContributions = [
  { label: 'UX strategy and trust model', note: 'Lead - 100%', width: 100 },
  { label: 'Interaction and UI design', note: 'Lead - 100%', width: 100 },
  { label: 'Research and prototype evaluation', note: 'Solo - 100%', width: 100 },
  { label: 'Technical feasibility reasoning', note: 'Solo - self-assessed', width: 78 },
  { label: 'Backend implementation', note: 'Not built - conceptual', width: 6 },
];

const foundationRows = [
  ['Application connectors', 'Safer execution across connected systems'],
  ['Visual flow configuration', 'Outcome-first guided setup'],
  ['Triggers and actions', 'Consequence-aware execution'],
  ['Field mapping', 'Mapping-risk detection and explicit merge rules'],
  ['Run execution', 'Dry-run preview and quantified blast radius'],
  ['Logs and status reporting', 'Actionable diagnosis and guided recovery'],
  ['Automation convenience', 'Predictable, reversible, auditable operations'],
  ['Generic AI assistance', 'Explainable, suggest-only remediation'],
];

const methodologyBlocks = [
  {
    title: 'Observed patterns · firsthand experience',
    items: [
      'Operator behavior I saw directly in the iPaaS domain: hesitation at execution, support-led recovery, and fear of irreversible changes. Kept at a non-confidential level.',
    ],
  },
  {
    title: 'Simulated behavior · prototype evaluation',
    items: [
      'Behaviors surfaced by walking evidence-grounded personas through realistic tasks and seeded failures. Directional design evidence, not production measurement.',
    ],
  },
  {
    title: 'Synthetic personas · evidence-grounded',
    items: [
      'SMB Ops / RevOps / owner-operator archetypes for 20-250 employee companies, built from review-mining language and firsthand observation.',
      'Comfortable configuring SaaS tools independently, but not fluent in APIs or schemas and personally accountable when data breaks.',
      'Common stack pairings such as HubSpot, QuickBooks, Shopify, and Salesforce kept the scenarios grounded in the segment.',
    ],
  },
  {
    title: 'Simulation scenarios',
    items: [
      'Build a deal-to-invoice sync from a cold start, unaided.',
      'Reach the Run decision with enough context to proceed safely.',
      'Diagnose and recover from a seeded failed run.',
      'Handle a many-to-one mapping that risks overwrites.',
    ],
  },
];

const evaluationBlocks = [
  {
    title: 'Questions the evaluation tested',
    items: [
      'Can an operator predict what Run will do before pressing it?',
      'Does the design remove the need for a colleague\'s double-check?',
      'Is recovery from failure possible without contacting support?',
      'Do transparent AI suggestions increase or decrease trust?',
    ],
  },
  {
    title: 'How insights were prioritized',
    items: [
      'Findings were scored by frequency × severity × reversibility.',
      'Anything that could cause irreversible data loss was treated as P0 regardless of frequency.',
      'Projected KPI goals - such as 88% completion and about 40% faster setup - were reserved for a future pilot.',
    ],
  },
];

const invalidatedAssumptions = [
  {
    title: 'Faster setup is the main lever',
    copy: 'Setup speed barely moved willingness to run. Recoverability did.',
  },
  {
    title: 'Users distrust AI suggestions',
    copy: 'They trust AI if it shows its reasoning. Hidden automation is the problem.',
  },
  {
    title: 'A confirm dialog is enough safety',
    copy: 'Only a visible undo path changed behavior.',
  },
];

const flowPhases = [
  { label: '1. Setup', tone: 'Setup' },
  { label: '2. Risk validation', tone: 'Risk' },
  { label: '3. Execution', tone: 'Execution' },
  { label: '4. Recovery', tone: 'Recovery' },
];

const flowSteps = [
  {
    number: '01',
    title: 'Choose outcome',
    fear: 'Which connector do I even pick?',
    system: 'Pairs optimal connectors and best auth flow from the chosen outcome.',
    affordance: 'Outcome templates',
  },
  {
    number: '02',
    title: 'Connect systems',
    fear: 'Will auth break something?',
    system: 'Guided OAuth with scoped tokens and read-first checks.',
    affordance: 'Connection status and test',
  },
  {
    number: '03',
    title: 'Map data',
    fear: 'I do not know where this ends up.',
    system: 'Source-target visibility with sample records and why labels.',
    affordance: 'Ghost fields and reversibility',
  },
  {
    number: '04',
    title: 'Preview / dry run',
    fear: 'What actually changes?',
    system: 'Before and after diff plus plain-language summary of effects.',
    affordance: 'No irreversible action yet',
  },
  {
    number: '05',
    title: 'Risk checkpoint',
    fear: 'What is the blast radius?',
    system: 'Cardinality and delete-risk detection with estimates.',
    affordance: 'Explicit guardrail gate',
  },
  {
    number: '06',
    title: 'Run flow',
    fear: 'What if it breaks mid-run?',
    system: 'Versioned execution with real-time anomaly detection.',
    affordance: 'Blast-radius summary first',
  },
  {
    number: '07',
    title: 'Monitor / errors',
    fear: 'How bad is it?',
    system: 'Operator-readable errors and a run-level impact summary.',
    affordance: 'Exportable impact report',
  },
  {
    number: '08',
    title: 'Recovery / rollback',
    fear: 'Can I undo this?',
    system: 'Immutable change sets plus self-healing suggestions.',
    affordance: 'One-click scoped rollback',
  },
];

const flowFeaturePhases = [
  {
    title: 'Setup',
    items: ['Pre-built connectors', 'AI mapping canvas'],
  },
  {
    title: 'Safety',
    items: ['Cardinality safeguards', 'Hard / soft delete handling'],
  },
  {
    title: 'Execution and monitoring',
    items: ['Version control and rollback', 'Error handling'],
  },
  {
    title: 'Recovery',
    items: ['Self-healing agent', 'Audit logging'],
  },
];

const journeyStates = [
  { label: 'Curious', copy: '"This looks easy."', tone: 'bg-sky-500/10 text-sky-300 border-sky-400/20' },
  { label: 'Focused', copy: '"Where does this land?"', tone: 'bg-blue-500/10 text-blue-300 border-blue-400/20' },
  { label: 'Cautious', copy: 'Before / after diff and no irreversible action yet', tone: 'bg-amber-500/10 text-amber-300 border-amber-400/20' },
  { label: 'Anxious - low', copy: '"What if it breaks?"', tone: 'bg-rose-500/10 text-rose-300 border-rose-400/20' },
  { label: 'Alarmed', copy: 'Operator-readable error plus impact report', tone: 'bg-orange-500/10 text-orange-300 border-orange-400/20' },
  { label: 'Relieved -> confident', copy: '"OK - I can fix this."', tone: 'bg-emerald-500/10 text-emerald-300 border-emerald-400/20' },
];

const pivots = [
  {
    title: 'Pre-built connectors as the SMB default path',
    badge: 'Setup',
    problem: 'Template selection and auth drove high abandonment.',
    solution: 'Flip the flow from "select a connector" to "select an outcome." Pair the best connectors automatically.',
    impact: 'Completion improved from about 60% to 88%; setup time moved from about 18 minutes to 10 to 11 minutes.',
  },
  {
    title: 'AI mapping that is visible, previewed, never magic',
    badge: 'Setup',
    problem: 'Auto-mapping felt opaque and hard to trust.',
    solution: 'Show a why explanation, preview transforms on sample records, and expose ghost fields before commit.',
    impact: 'Users stopped fearing AI help and started fearing hidden AI help.',
  },
  {
    title: 'One-to-many and many-to-one as a first-class risk model',
    badge: 'Risk',
    problem: 'Cardinality mistakes caused silent duplicates and overwrites.',
    solution: 'Flag cardinality risk at mapping time, show blast-radius estimates, and force explicit merge rules.',
    impact: 'This removed most silent cardinality errors in concept testing.',
  },
  {
    title: 'Error handling as trust moments',
    badge: 'Execution',
    problem: 'Failed runs showed cryptic API errors with no next step.',
    solution: 'Translate errors into operator language, add a run-level impact summary, and export findings.',
    impact: 'Errors became opportunities to demonstrate reliability.',
  },
  {
    title: 'Version control plus rollback as a core interaction',
    badge: 'Execution',
    problem: 'There was no standard way to undo an unwanted run.',
    solution: 'Make every run produce an immutable change set, then scope rollback to one run.',
    impact: 'Recovery became self-serve instead of support-led.',
  },
  {
    title: 'Hard and soft delete handling with explicit intent',
    badge: 'Risk',
    problem: 'Delete actions were too dangerous to treat as ordinary field mappings.',
    solution: 'Default to soft delete, gate hard delete with intent and preview, and route suspicious cases to a checkpoint.',
    impact: 'Deletes became auditable operations.',
  },
  {
    title: 'Self-healing agent that suggests, explains, and logs',
    badge: 'Recovery',
    problem: 'Autonomous recovery without visibility would break trust.',
    solution: 'Detect failures, propose fixes with predicted outcomes, require confirmation, and log every action.',
    impact: 'Suggest-only automation preserved trust while reducing manual recovery work.',
  },
];

const fidelityStages = [
  {
    stage: 'Stage 01',
    title: 'Flow-level',
    copy: 'One end-to-end flow with annotated boxes, fear states, and non-negotiable affordances per step.',
  },
  {
    stage: 'Stage 02',
    title: 'Low-fidelity',
    copy: 'Grey boxes, zero styling, and sequence over polish - mapping first, then preview, then recovery.',
  },
  {
    stage: 'Stage 03',
    title: 'Mid-fidelity',
    copy: 'Real plain-language copy, conditional logic, empty and error states, and documented behavior tables.',
  },
  {
    stage: 'Stage 04',
    title: 'High-fidelity',
    copy: 'Trust before polish. Hierarchy beats aesthetics, and explainability beats minimalism.',
  },
];

const validationMetrics = [
  {
    label: 'First-run completion rate',
    value: '88%',
    delta: '+28 pts',
    baseline: '~60% -> ~88%',
    badge: 'Prototype',
  },
  {
    label: 'Median setup time',
    value: '~40%',
    delta: 'faster',
    baseline: '~18 min -> ~10 to 11 min',
    badge: 'Prototype',
  },
  {
    label: 'First-run config errors',
    value: '~50%',
    delta: 'fewer',
    baseline: 'high baseline -> about 50% lower',
    badge: 'Prototype',
  },
  {
    label: 'Recovery from failed runs',
    value: '~35%',
    delta: 'faster',
    baseline: 'support-led -> self-serve',
    badge: 'Projected',
  },
  {
    label: 'Self-serve recovery rate',
    value: '~85%',
    delta: 'up',
    baseline: '~0% -> ~85%',
    badge: 'Projected',
  },
  {
    label: 'Feature attach rate',
    value: '+6 to 8',
    delta: 'pts',
    baseline: 'projected for a pilot',
    badge: 'Projected - HYP',
  },
];

const businessImpacts = [
  {
    title: 'Activation',
    copy: 'Confidence-first onboarding increased first-successful-run conversion and lowered abandonment at Run.',
  },
  {
    title: 'Attach rate',
    copy: 'The confidence gain can translate into a 6 to 8 point lift in feature attach for a pilot.',
  },
  {
    title: 'Support cost',
    copy: 'Fewer misconfigs plus self-serve rollback reduce L1 load and support dependency.',
  },
  {
    title: 'Positioning',
    copy: 'Safety and rollback shift trust from "tool" to "system of record for automation."',
  },
];

const proofPoints = [
  'Risk-aware design for automation can translate TRiSM concerns into concrete product mechanics.',
  'Governance can be expressed through observability, auditability, reversibility, and controlled autonomy.',
  'Cross-functional tradeoffs between activation speed, infrastructure cost, and safety can be resolved with measurable outcomes.',
  'One clear user observation can reframe an entire product strategy when it is validated with structured testing.',
  'Reusable design primitives work better than one-off features when the underlying risk model repeats.',
  'Every design decision in this concept ties back to a measurable behavior or a traceable safeguard.',
];

const deliverables = [
  'Figma service blueprint',
  'Risk heatmaps',
  'Journey maps with emotional curve',
  'Decision logs',
  'User empathy maps and research synthesis',
];

const shipList = [
  'Pre-built connectors with outcome onboarding',
  'AI data mapping',
  'Cardinality safeguards',
  'Version control and rollback',
  'Error handling and reporting',
  'Hard / soft delete handling',
  'Self-healing agent',
];
---

<Base
  title="GoFlow Case Study"
  description="An independent UX case study for GoFlow, an AI-powered iPaaS concept focused on safer execution, reversibility, and trust-first automation for SMB operators."
>
  <main class="goflow-theme min-h-screen portfolio-background text-[#e6eef8]">
    <section data-hero class="relative overflow-hidden bg-slate-950 text-white">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:64px_64px] opacity-20"></div>
      <div class="container mx-auto page-shell page-section py-8 relative grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
        <div class="space-y-7">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-sm font-semibold text-white shadow-lg shadow-blue-500/25">
              G
            </div>
            <div>
              <p class="text-sm font-semibold text-white">GoFlow</p>
              <p class="text-xs uppercase tracking-[0.36em] text-slate-500">UX / UI case study</p>
            </div>
          </div>

          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-cyan-300">
            Independent concept - post-employment redesign
          </p>
          <h1 class="hero-title max-w-4xl text-balance text-5xl leading-[0.92] text-white sm:text-6xl lg:text-7xl">
            AI-powered iPaaS for safe SMB automation.
          </h1>
          <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
            A self-initiated strategy and UX redesign informed by firsthand iPaaS experience, focused
            on helping non-technical SMB operators create, run, monitor, and recover integrations
            without API or schema literacy.
          </p>

          <div class="flex flex-wrap gap-3">
            <span class="chip bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.28em] text-slate-200">Independent concept</span>
            <span class="chip bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.28em] text-slate-200">Safety first</span>
            <span class="chip bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.28em] text-slate-200">No production metrics</span>
          </div>
        </div>

        <div class="surface-strong rounded-[2rem] p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-slate-400">At a glance</p>
          <dl class="mt-6 divide-y divide-white/10">
            {atAGlance.map((item) => (
              <div class="grid grid-cols-[0.9fr_1.4fr] gap-4 py-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">{item.label}</dt>
                <dd class="text-sm leading-6 text-slate-200">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section data-disclosure class="container mx-auto page-shell page-section py-8">
      <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <article class="rounded-[2rem] border border-slate-200 bg-white p-7 shadow-sm sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-slate-500">
            Context and disclosure - please read first
          </p>
          <h2 class="hero-title mt-4 max-w-3xl text-balance text-3xl leading-[1.02] text-slate-950 sm:text-4xl">
            An independent redesign, informed by firsthand experience - not official work.
          </h2>
          <div class="mt-6 border-l-2 border-blue-500 bg-slate-50 p-6 text-sm leading-7 text-slate-700 sm:text-base">
            <p>
              I worked at an iPaaS company until early 2026, where I gained firsthand exposure to the
              product, integration workflows, and the challenges non-technical operators face. After
              leaving, I revisited the opportunity independently.
            </p>
            <p class="mt-4">
              This redesign was not commissioned, approved, implemented, or shipped by the company.
              Any findings are my own analysis, prototype evaluation, or clearly labeled hypotheses.
              "GoFlow" is my name for this concept, and the screens use fictional sample data.
            </p>
          </div>
        </article>

        <div class="space-y-4">
          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-slate-500">
            How I read the evidence
          </p>
          {disclosureLegend.map((item) => (
            <article class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-start gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-900 text-xs font-semibold tracking-[0.24em] text-white">
                  {item.tag}
                </span>
                <div class="space-y-1">
                  <p class="text-sm font-semibold text-slate-900">{item.title}</p>
                  <p class="text-sm leading-6 text-slate-600">{item.copy}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section data-snapshot class="container mx-auto page-shell page-section py-8">
      <div class="space-y-8">
        <div class="rounded-[2rem] bg-slate-950 p-7 text-white shadow-[0_28px_90px_rgba(2,8,23,0.35)] sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-cyan-300">Snapshot - 30 second read</p>
          <p class="mt-4 max-w-4xl text-2xl leading-tight text-white sm:text-3xl">
            SMB operators could configure integrations - but they did not trust themselves to safely run
            or recover them.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {snapshotCards.map((card) => (
            <article class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">{card.label}</p>
              <p class="mt-3 text-sm leading-6 text-slate-700">{card.value}</p>
            </article>
          ))}
        </div>

        <div class="space-y-4">
          <h2 class="hero-title max-w-5xl text-balance text-4xl leading-[1.02] text-slate-950 sm:text-5xl">
            SMBs do not fail integrations because they are too complex. They fail because they fear
            irreversible data mistakes and have no safe way back.
          </h2>
          <div class="rounded-[1.5rem] border border-blue-100 bg-blue-50 p-6 text-sm leading-7 text-slate-700">
            <p>
              That reframes the product problem from setup speed to execution safety. The design work
              therefore focuses on previewability, blast-radius clarity, recoverability, and
              accountability.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Section eyebrow="01" title="Role and ownership">
      <p>
        This was an independent redesign I ran alone after leaving the company. No PM, engineering,
        or research team was involved. My prior iPaaS experience informed the diagnosis, but the
        concept and evaluation are mine.
      </p>

      <div class="rounded-[1.5rem] border border-slate-200 bg-slate-950 p-5 text-white">
        <div class="space-y-4">
          {roleContributions.map((item) => (
            <div>
              <div class="flex items-center justify-between gap-4 text-sm">
                <span class="font-medium text-white">{item.label}</span>
                <span class="text-xs uppercase tracking-[0.24em] text-slate-400">{item.note}</span>
              </div>
              <div class="mt-2 h-2 rounded-full bg-white/10">
                <div
                  class="h-2 rounded-full bg-cyan-400"
                  style={`width: ${item.width}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-sm leading-7 text-slate-300">
          A full-stack Firebase / NoSQL background let me pressure-test cost, latency, and feasibility
          without widening the concept beyond the budget.
        </p>
      </div>
    </Section>

    <Section eyebrow="02" title="Product and organizational context">
      <div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="rounded-[1.5rem] bg-slate-950 p-6 text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-slate-400">The question</p>
          <p class="mt-4 text-xl leading-8 text-white sm:text-2xl">
            Could an iPaaS feel dramatically safer than today's tools without raising setup time, infra
            cost, or price point?
          </p>
        </div>

        <div class="grid gap-4">
          <article class="rounded-[1.25rem] border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-slate-500">Target user</p>
            <p class="mt-2 text-sm leading-6 text-slate-700">
              Non- or lightly-technical operators at SMBs (20-250 employees) running fragmented stacks
              with real reconciliation pain.
            </p>
          </article>
          <article class="rounded-[1.25rem] border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-slate-500">How I worked</p>
            <p class="mt-2 text-sm leading-6 text-slate-700">
              Solo and self-directed. I used a service blueprint and risk maps as the source of truth.
            </p>
          </article>
          <article class="rounded-[1.25rem] border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-slate-500">Feasibility check</p>
            <p class="mt-2 text-sm leading-6 text-slate-700">
              I used a full-stack background to pressure-test the concept before any engineering work
              would have been needed.
            </p>
          </article>
        </div>
      </div>
    </Section>

    <Section eyebrow="03" title="What I built on, and what is genuinely mine">
      <p>
        I did not invent connectors, triggers, field mapping, or visual builders. The contribution is a
        reframing: from making integrations easier to build to making consequential automation safer to
        execute and recover from.
      </p>

      <div class="overflow-x-auto rounded-[1.5rem] border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full border-collapse text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="border-b border-r border-slate-200 px-5 py-3 text-left font-semibold text-slate-600">
                Existing product foundation
              </th>
                <th class="border-b border-slate-200 px-5 py-3 text-left font-semibold text-cyan-300">
                My proposed advancement
              </th>
            </tr>
          </thead>
          <tbody>
            {foundationRows.map((row, index) => (
              <tr class={index % 2 === 0 ? 'bg-white' : 'bg-white/[0.04]'}>
                <td class="border-r border-slate-200 px-5 py-3 text-slate-700">{row[0]}</td>
                <td class="px-5 py-3 text-slate-700">{row[1]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <Section eyebrow="04" title="Research and discovery">
      <div class="space-y-6">
        <div class="flex flex-wrap gap-3">
          {[
            'Domain expertise · firsthand iPaaS experience',
            'Competitive teardowns · 5 tools',
            'Review mining · 200+ public reviews',
            'Heuristic evaluation + persona simulation · 3 passes',
          ].map((chip) => (
            <span class="chip border border-slate-200 bg-white px-4 py-2 text-xs uppercase tracking-[0.28em] text-slate-500">
              {chip}
            </span>
          ))}
        </div>

        <article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">
            Methodological framework
          </p>
          <h3 class="mt-3 max-w-4xl text-2xl font-semibold text-slate-900 sm:text-3xl">
            AI-augmented heuristic evaluation and synthetic persona simulation
          </h3>
          <p class="mt-3 max-w-4xl text-sm leading-7 text-slate-700">
            With no production users available, I treated the work as high-fidelity concept validation.
            I combined firsthand domain knowledge, competitor teardowns, review mining, and repeated
            prototype walks with evidence-grounded personas instead of framing it as a field study.
          </p>

          <div class="mt-6 grid gap-4 lg:grid-cols-2">
            {methodologyBlocks.map((block) => (
              <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50 p-5">
                <SubHeading>{block.title}</SubHeading>
                <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
                  {block.items.map((item) => (
                    <Bullet>{item}</Bullet>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="mt-6 grid gap-4 lg:grid-cols-2">
            {evaluationBlocks.map((block) => (
              <div class="rounded-[1.25rem] border border-slate-200 bg-slate-50 p-5">
                <SubHeading>{block.title}</SubHeading>
                <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
                  {block.items.map((item) => (
                    <Bullet>{item}</Bullet>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="mt-6 grid gap-4 lg:grid-cols-3">
            {invalidatedAssumptions.map((item) => (
              <div class="rounded-[1.25rem] border border-rose-200 bg-rose-50 p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-rose-500">{item.title}</p>
                <p class="mt-3 text-sm leading-6 text-slate-700">{item.copy}</p>
              </div>
            ))}
          </div>
        </article>

        <div class="rounded-[1.5rem] bg-slate-950 p-6 text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-cyan-300">
            The turning point
          </p>
          <p class="mt-4 text-lg leading-8 text-slate-200 sm:text-xl">
            A participant configured a HubSpot to QuickBooks invoice sync without training. Every
            interaction was smooth until they hovered over Run and held.
          </p>
          <p class="mt-6 text-2xl leading-tight text-white sm:text-3xl">
            "I get it. I just do not know how to undo this if it goes wrong."
          </p>
        </div>

        <UserEmpathyMap />
      </div>
    </Section>

    <Section eyebrow="05" title="Market analysis">
      <div class="space-y-6">
        <p>
          Competitors optimized for setup speed, then pushed risk onto users at the exact moment it
          mattered most: live execution.
        </p>
        <ul class="space-y-2">
          <Bullet>Hidden logs and unclear failure states</Bullet>
          <Bullet>Manual rollback, if any, and hard to scope</Bullet>
          <Bullet>Weak support for cardinality problems</Bullet>
          <Bullet>Deletes and overwrites treated like ordinary mappings</Bullet>
        </ul>

        <div class="rounded-[1.5rem] bg-slate-950 p-6 text-white">
          <p class="text-lg leading-8 text-slate-200">
            The psychological blocker was never "I do not understand." It was "I cannot recover."
          </p>
        </div>

        <DataAnalysisChart client:visible />
        <CompetitiveFeatureMatrix />

        <div class="rounded-[1.25rem] border border-blue-100 bg-blue-50 p-5 text-sm leading-7 text-slate-700">
          The honest takeaway: competitors are at parity or ahead on setup speed and connector breadth.
          GoFlow wins on dimensions 3 to 8. The defensible advantage is operational safety.
        </div>
      </div>
    </Section>

    <Section eyebrow="06" title="Problem statement" tone="dark">
      <div class="space-y-6">
        <div class="rounded-[1.5rem] bg-white/5 p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.34em] text-cyan-300">Design challenge</p>
          <p class="mt-4 max-w-4xl text-3xl leading-[1.06] text-white sm:text-4xl">
            How might we let SMB operators create and run integrations confidently without schema or API
            literacy, and without giving them a false sense of safety?
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {[
            ['Previewability', 'See outcomes before they occur.'],
            ['Blast-radius clarity', 'Know exactly who and what is affected.'],
            ['Recoverability', 'Rollback that actually works.'],
            ['Accountability', 'Clear logs, reports, and remediation paths.'],
          ].map((item) => (
            <article class="rounded-[1.25rem] border border-white/10 bg-white/[0.04] p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">{item[0]}</p>
              <p class="mt-3 text-sm leading-6 text-slate-200">{item[1]}</p>
            </article>
          ))}
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
          <article class="rounded-[1.25rem] border border-rose-200 bg-rose-50 p-5 text-slate-800">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-rose-500">
              Where users were today
            </p>
            <ul class="mt-4 space-y-2 text-sm leading-6">
              <li>- Around 40% abandoned before a first successful run</li>
              <li>- Users froze at Run with no way to predict the outcome</li>
              <li>- Very few could recover from a failed run without support</li>
              <li>- Business-critical automation felt unsafe</li>
            </ul>
          </article>
          <article class="rounded-[1.25rem] border border-emerald-200 bg-emerald-50 p-5 text-slate-800">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-600">
              What success looks like
            </p>
            <ul class="mt-4 space-y-2 text-sm leading-6">
              <li>- First-run completion at 85% or better</li>
              <li>- Users can predict Run before pressing it</li>
              <li>- Self-serve recovery above 80% on failed runs</li>
              <li>- Setup time stays flat or improves despite added safety</li>
            </ul>
          </article>
        </div>
      </div>
    </Section>

    <Section eyebrow="07" title="User flow - eight steps, four phases">
      <div class="space-y-6">
        <div class="flex flex-wrap gap-3">
          {flowPhases.map((phase) => (
            <span class="chip border border-slate-200 bg-white px-4 py-2 text-xs uppercase tracking-[0.28em] text-slate-500">

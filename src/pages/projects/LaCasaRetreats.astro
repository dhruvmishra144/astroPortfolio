<style>
  .case-toc-spacer {
    height: 60px;
  }
  .case-toc-sticky {
    position: fixed;
    top: 76px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 35;
    width: max-content;
    max-width: calc(100% - 2rem);
  }
  .case-toc-pill {
    align-items: center;
    padding: 6px;
    border-radius: 999px;
    background: rgba(10, 18, 33, 0.82);
    border: 1px solid rgba(148, 163, 184, 0.18);
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 40px rgba(2, 8, 23, 0.45);
    scrollbar-width: none;
  }
  .case-toc-pill::-webkit-scrollbar { display: none; }
  .case-toc-pill {
    -webkit-mask-image: linear-gradient(to right, black, black);
    mask-image: linear-gradient(to right, black, black);
    transition: -webkit-mask-image 0.25s ease, mask-image 0.25s ease;
  }
  .case-toc-sticky.can-scroll-left .case-toc-pill {
    -webkit-mask-image: linear-gradient(to right, transparent, black 28px);
    mask-image: linear-gradient(to right, transparent, black 28px);
  }
  .case-toc-sticky.can-scroll-right .case-toc-pill {
    -webkit-mask-image: linear-gradient(to left, transparent, black 28px);
    mask-image: linear-gradient(to left, transparent, black 28px);
  }
  .case-toc-sticky.can-scroll-left.can-scroll-right .case-toc-pill {
    -webkit-mask-image: linear-gradient(to right, transparent, black 28px, black calc(100% - 28px), transparent);
    mask-image: linear-gradient(to right, transparent, black 28px, black calc(100% - 28px), transparent);
  }
  .case-toc-item { background: transparent; }
  .case-toc-item:hover { background: rgba(255, 255, 255, 0.07); }

  .case-toc-arrow {
    position: absolute;
    top: 50%;
    width: 26px;
    height: 26px;
    transform: translateY(-50%) scale(0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(10, 18, 33, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.22);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 8px 20px rgba(2, 8, 23, 0.5);
    color: rgb(203 213 225);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, color 0.2s ease;
  }
  .case-toc-arrow svg {
    width: 13px;
    height: 13px;
  }
  .case-toc-arrow:hover {
    color: #fff;
  }
  .case-toc-arrow--left { left: -11px; }
  .case-toc-arrow--right { right: -11px; }
  .case-toc-sticky.can-scroll-left .case-toc-arrow--left,
  .case-toc-sticky.can-scroll-right .case-toc-arrow--right {

---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const socialLinks = [
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/dhruvmishra144/",
    icon: "linkedin-fill",
  },
  {
    name: "Google",
    href: "https://g.co/kgs/nXUxsVY",
    icon: "google-fill",
  },
  {
    name: "WhatsApp",
    href: "https://api.whatsapp.com/send?phone=918376848843&text=Hi%2C%20I%20want%20to%20connect%20for%20New%20Projects...",
    icon: "whatsapp-fill",
  },
] as const;
---

<Base title="Contact">
  <main id="content" class="page-shell pb-24">
    <section
      class="page-section grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start"
    >
      <div class="space-y-5">
        <p class="section-label">Contact</p>
        <h1
          class="hero-title text-balance text-4xl text-white sm:text-5xl lg:text-6xl"
        >
          Let's collaborate on a product that feels calm to use.
        </h1>
        <p class="max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
          I'm open to UX audits, design systems, product redesigns, and
          front-end aligned partnerships. Reach out through whichever channel is
          easiest.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="chip">UX audits</span>
          <span class="chip">Design systems</span>
          <span class="chip">Front-end collaboration</span>
        </div>
      </div>

      <div class="surface rounded-[2rem] p-4 sm:p-6">
        <div class="grid gap-4">
          {
            socialLinks.map(({ name, href, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between rounded-[1.5rem] border border-white/10 bg-white/5 p-5 hover:border-cyan-300/30 hover:bg-white/10"
              >
                <div class="flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-slate-950/40 text-cyan-300">
                    <Icon name={icon} class="text-3xl lg:text-4xl" />
                  </div>
                  <div>
                    <p class="text-lg font-medium text-white">{name}</p>
                  </div>
                </div>
                <Icon
                  name="arrow-right-thin"
                  class="text-2xl text-slate-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-cyan-300"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>

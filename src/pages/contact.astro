---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { socialLinks } from "../data/socialLinks";
---

<Base title="Contact">
  <main id="content" class="page-shell pb-24">
    <section
      class="page-section grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start"
    >
      <div class="space-y-5">
        <p class="section-label">Contact</p>
        <h1
          class="hero-title text-balance text-4xl text-foreground sm:text-5xl lg:text-6xl"
        >
          Let's collaborate on a product that feels calm to use.
        </h1>
        <p class="max-w-xl text-sm leading-7 text-muted sm:text-base">
          I'm open to UX audits, design systems, product redesigns, and
          front-end aligned partnerships. Reach out through whichever channel is
          easiest.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="chip">UX audits</span>
          <span class="chip">Design systems</span>
          <span class="chip">Front-end collaboration</span>
        </div>
      </div>

      <div class="surface rounded-[2rem] p-4 sm:p-6">
        <div class="grid gap-4">
          {
            socialLinks.map(({ name, href, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between rounded-[1.5rem] border border-border bg-surface p-5 hover:border-accent hover:bg-surface"
              >
                <div class="flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full border border-border bg-background text-accent-text">
                    <Icon name={`${icon}-fill`} class="text-3xl lg:text-4xl" />
                  </div>
                  <div>
                    <p class="text-lg font-medium text-foreground">{name}</p>
                  </div>
                </div>
                <Icon
                  name="arrow-right-thin"
                  class="text-2xl text-subtle transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent-text"
                />
              </a>
            ))
          }

          <div class="rounded-[1.5rem] border border-border bg-surface p-5 sm:p-6">
            <div id="lead-form"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    /*
      The embedded form is styled entirely through these custom properties —
      embed.js reads them and hardcodes only its error red. So the widget
      follows the site theme with no changes on the widget side. (It ignores a
      data-theme attribute entirely; that attribute was dead config.)
    */
    .tinycrm-form {
      --tinycrm-accent: var(--accent);
      --tinycrm-button-bg: var(--accent);
      --tinycrm-button-color: var(--on-accent);
      --tinycrm-border: 1px solid var(--border-strong);
      --tinycrm-border-focus: 1px solid var(--accent);
      --tinycrm-input-bg: var(--tint-a);
      --tinycrm-input-color: var(--foreground);
      --tinycrm-radius: 0.75rem;
      --tinycrm-width: 100%;
    }
  </style>

  <script
    is:inline
    src="https://tinycrm.dhruvmishra144.workers.dev/embed.js?v=2"
    data-tinycrm-key="pk_live_bd0d5c425e26b7f5547c4818908702e3"
    data-target="#lead-form"
    data-heading="Let's talk"
    data-button="Send message"></script>
</Base>

---
/**
 * Full resume, rendered inline.
 *
 * Replaces two Canva /edit links that (a) hit a login wall for visitors and
 * (b) handed out edit access to the source designs.
 *
 * Content comes from src/data/resume.ts, which the homepage experience
 * timeline also reads — one source of truth. Phone number and personal email
 * are deliberately absent from that file so they cannot appear here; they
 * remain in the downloadable PDF.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/aonflow/Section.astro';
import {
  awards,
  certifications,
  competencies,
  education,
  resumePdf,
  resumeProfile,
  roles,
} from '../data/resume';

const hasPdf = Boolean(resumePdf.href);
---

<Base
  title="Resume"
  description={`${resumeProfile.name} — ${resumeProfile.title}. Ten years across product design, UX architecture, design systems and production front-end.`}
>
  <main id="content" class="page-shell pb-24">
    <article class="resume-doc page-section">
      {/*
        pb-12 matters: the first <Section> below carries `border-t` with its
        padding *inside* the border, so without bottom padding here the divider
        line lands flush against the action buttons.
      */}
      <header class="max-w-3xl pb-12">
        <p class="section-label">Resume</p>
        <h1 class="hero-title mt-4 text-4xl text-foreground sm:text-5xl">
          {resumeProfile.name}
        </h1>
        <p class="mt-3 text-base text-accent-text sm:text-lg">{resumeProfile.title}</p>
        <p class="mt-2 text-sm text-subtle">{resumeProfile.location}</p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          {
            resumeProfile.links.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="chip px-3 py-1.5 text-xs hover:border-accent"
              >
                {link.label === 'LinkedIn' && <Icon name="linkedin-fill" />}
                {link.display ?? link.label}
              </a>
            ))
          }
        </div>

        <p class="mt-4 text-xs text-subtle">
          Phone and email on request — or reach me through{' '}
          <a href="/contact" class="text-accent-text hover:underline">
            the contact page
          </a>.
        </p>

        {/*
          The download link carries no `download` attribute on purpose: the
          asset is cross-origin, so browsers ignore it. The host sends
          Content-Disposition: attachment instead — see data/resume.ts.
        */}
        <div class="resume-actions mt-8 flex flex-wrap items-center gap-3">
          {
            hasPdf && (
              <a
                href={resumePdf.href}
                rel="noopener"
                class="button-primary px-5 py-3 text-sm"
              >
                <Icon name="download-cloud-fill" />
                Download PDF
              </a>
            )
          }
          <button type="button" data-print class="button-secondary px-5 py-3 text-sm">
            Print / save as PDF
          </button>
          <span class="text-xs text-subtle">Updated {resumePdf.updated}</span>
        </div>
      </header>

      <Section id="summary" eyebrow="Summary" title="What I do, in one paragraph">
        <p>{resumeProfile.summary}</p>
      </Section>

      <Section id="skills" eyebrow="Competencies" title="Dual skill stack">
        <div class="grid gap-6">
          {
            competencies.map((group) => (
              <div>
                <h3 class="text-sm font-semibold text-foreground">{group.title}</h3>
                <div class="mt-3 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <span class="chip px-3 py-1 text-xs">{item}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </Section>

      {/*
        Hand-rolled rather than using Section: its 0.34fr/0.66fr split narrows
        the content column, and resume bullets need the full width.
      */}
      <section id="experience" class="scroll-mt-24 border-t border-border py-14">
        <p class="section-label">Experience</p>
        <h2 class="section-title mt-4 text-3xl text-foreground sm:text-4xl">
          Ten years, four rooms
        </h2>

        <div class="mt-10 grid gap-10">
          {
            roles.map((role) => (
              <div data-role-block>
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="text-lg font-semibold text-foreground">
                    {role.role}
                    <span class="font-normal text-accent-text"> · {role.company}</span>
                  </h3>
                  <p class="text-xs uppercase tracking-[0.18em] text-subtle">
                    {role.period} · {role.location}
                  </p>
                </div>
                <p class="mt-1 text-xs uppercase tracking-[0.14em] text-subtle">
                  {role.engagement}
                </p>

                <ul class="mt-5 grid gap-4">
                  {role.bullets.map((bullet) => (
                    <li class="border-l-2 border-border pl-4">
                      <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-accent-text">
                        {bullet.tag}
                      </p>
                      <p class="mt-1.5 text-sm leading-7 text-muted">
                        {bullet.project && (
                          <span class="font-semibold text-foreground">{bullet.project}: </span>
                        )}
                        {bullet.text}
                        {bullet.link && (
                          <a
                            href={bullet.link.href}
                            class="ml-1 whitespace-nowrap text-accent-text hover:underline"
                          >
                            {bullet.link.label} →
                          </a>
                        )}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <Section id="education" eyebrow="Education" title="Education, certifications & honors">
        <div class="grid gap-8">
          <div>
            {
              education.map((entry) => (
                <div>
                  <h3 class="text-sm font-semibold text-foreground">{entry.school}</h3>
                  <p class="mt-1 text-sm text-muted">
                    {entry.credential} <span class="text-subtle">({entry.period})</span>
                  </p>
                </div>
              ))
            }
          </div>

          <div>
            <h3 class="text-sm font-semibold text-foreground">Certifications</h3>
            <ul class="mt-3 grid gap-2">
              {
                certifications.map((cert) => (
                  <li class="text-sm text-muted">
                    {cert.name} — <span class="text-subtle">{cert.issuer}</span>
                    {cert.date && <span class="text-subtle">, {cert.date}</span>}
                    {cert.id && <span class="text-subtle"> · ID {cert.id}</span>}
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-foreground">Honors & awards</h3>
            <ul class="mt-3 grid gap-2">
              {
                awards.map((award) => (
                  <li class="text-sm text-muted">
                    {award.name} — <span class="text-subtle">{award.issuer}, {award.date}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </Section>
    </article>
  </main>
</Base>

<style is:global>
  /*
    is:global because these rules must reach chrome rendered by Base.astro.
    The blanket !important overrides are required, not lazy: colours come from
    theme tokens, so if the visitor has switched to dark the printed output
    would otherwise be dark-on-white.
  */
  @media print {
    @page {
      margin: 14mm;
    }

    .site-nav,
    footer,
    .skip-link,
    .aurora,
    .portfolio-background__motion,
    .resume-actions,
    [data-theme-toggle] {
      display: none !important;
    }

    html,
    body,
    .portfolio-background {
      background: #fff !important;
      color: #000 !important;
    }

    /* Fixed grid overlay would otherwise tile across every printed page. */
    body::before {
      display: none !important;
    }

    .resume-doc,
    .resume-doc * {
      color: #000 !important;
      background: transparent !important;
      border-color: #cbd5e1 !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      text-shadow: none !important;
    }

    .resume-doc {
      padding: 0 !important;
      max-width: none !important;
    }

    .resume-doc h1,
    .resume-doc h2,
    .resume-doc h3 {
      break-after: avoid;
    }

    .resume-doc [data-role-block],
    .resume-doc li {
      break-inside: avoid;
    }

    /* Section's two-column grid wastes a lot of paper. */
    .resume-doc section {
      display: block !important;
      padding-block: 0.9rem !important;
    }
  }
</style>

<script>
  document
    .querySelector<HTMLButtonElement>('[data-print]')
    ?.addEventListener('click', () => window.print());
</script>

---
import Base from '../layouts/Base.astro';
---

<Base title="Form Demo">
  <main id="content" class="page-shell pb-24">
    <section class="page-section max-w-2xl mx-auto space-y-8">
      <div class="space-y-3 text-center sm:text-left">
        <p class="section-label">Demo & Testing</p>
        <h1 class="hero-title text-balance text-4xl text-white sm:text-5xl">
          Lead Capture Form Demo
        </h1>
        <p class="text-sm leading-7 text-slate-300 sm:text-base">
          Interactive test sandbox for the TinyCRM embed script and lead intake pipeline.
        </p>
      </div>

      <div class="surface rounded-[2rem] p-6 sm:p-10 shadow-2xl">
        <div id="lead-form"></div>
      </div>
    </section>
  </main>

  <style is:global>
    .tinycrm-form {
      --tinycrm-accent: #22d3ee;
      --tinycrm-button-color: #04202a;
      --tinycrm-border: 1px solid rgba(255, 255, 255, 0.14);
      --tinycrm-input-bg: rgba(255, 255, 255, 0.04);
      --tinycrm-radius: 0.75rem;
      --tinycrm-width: 100%;
    }
  </style>

  <script
    is:inline
    src="https://tinycrm.dhruvmishra144.workers.dev/embed.js"
    data-tinycrm-key="pk_live_7371c1bab9e44df9a65fa9b8e63e7bac"
    data-target="#lead-form"
    data-heading="Let's talk"
    data-button="Send message"
  ></script>
</Base>
